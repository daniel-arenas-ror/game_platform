<%# A catalog card: art, category, name, tagline, players and minutes, and the Play button.
    The name is a stretched link to the game page (not in change-game mode); the button sits
    above it. Lit with the game's accent on hover. Put data-reveal on a wrapper, not on the card
    (the reveal's transition would replace the hover one). Locals: game, priority (first row loads
    first), room (change-game mode), sizes (art `sizes`). %>
<%
  room = local_assigns[:room]
  accent = game_accent(game)
  current_game = room&.game_id == game.id
  link_css = "rounded focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-400"
%>
<article style="--accent: var(<%= accent[:var] %>)"
         class="group relative flex flex-col h-full rounded-[1.75rem] bg-slate-800 border-2 overflow-hidden transition-[border-color,translate] duration-300 ease-out-expo hover:-translate-y-1.5 <%= current_game ? "border-purple-500" : "border-slate-700 hover:border-(--accent)" %>">
  <div class="relative aspect-[16/10] overflow-hidden bg-slate-700">
    <%= game_art_tag game, alt: t("games.index.image_alt", game: game.name), card: true, priority: local_assigns[:priority],
          sizes: local_assigns[:sizes] || "(min-width: 1280px) 400px, (min-width: 1024px) 32vw, (min-width: 768px) 48vw, 100vw",
          class: "w-full h-full object-cover object-top transition-transform duration-500 ease-out-expo group-hover:scale-105" %>
    <span class="absolute top-3 left-3 rounded-full bg-slate-950/80 px-3 py-1 text-xs font-bold text-white"><%= game_category_label(game) %></span>
    <% if current_game %>
      <span class="absolute top-3 right-3 rounded-full bg-purple-600 px-3 py-1 text-xs font-bold text-white"><%= t("games.index.current_game") %></span>
    <% end %>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <h2 class="font-display text-2xl font-extrabold text-white text-balance">
      <% if room || game.slug.blank? %>
        <%= game.name %>
      <% else %>
        <%= link_to game.name, game_path(game), class: "after:absolute after:inset-0 #{link_css}" %>
      <% end %>
    </h2>
    <p class="mt-2 text-slate-400 line-clamp-2 text-pretty"><%= game.tagline.presence || game.description %></p>

    <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm font-semibold text-slate-300">
      <li class="inline-flex items-center gap-1.5"><%= game_page_icon(:users, css: "size-4 #{accent[:text]}") %><%= game_players_label(game) %></li>
      <% if game.duration_minutes %>
        <li class="inline-flex items-center gap-1.5"><%= game_page_icon(:clock, css: "size-4 #{accent[:text]}") %><%= t("games.show.about_minutes", count: game.duration_minutes) %></li>
      <% end %>
    </ul>

    <div class="mt-auto pt-6">
      <% if room %>
        <%= button_to change_game_room_path(room.code), params: { game_id: game.id }, method: :post, form_class: "relative z-10",
              class: "btn w-full #{"btn-secondary" unless current_game}" do %>
          <%= current_game ? t("games.index.configure") : t("games.index.switch") %>
        <% end %>
      <% else %>
        <%= button_to rooms_path(game_id: game.id), method: :post, form_class: "relative z-10", class: "btn w-full",
              form: select_game_analytics(game) do %>
          <%= t("games.index.play_now") %>
        <% end %>
      <% end %>
    </div>
  </div>
</article>
