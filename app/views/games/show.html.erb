<% content_for :title, t(".title", game: @game.name) %>
<% content_for :description, @game.description %>
<% content_for :og_image, "/games/#{@game.code}/og.png" if File.exist?(Rails.public_path.join("games", @game.code, "og.png")) %>
<% content_for :head do %>
  <script type="application/ld+json"><%= raw json_escape(game_structured_data(@game).to_json) %></script>
<% end %>

<%
  accent = game_accent(@game)
  start_cta = "btn btn-lg w-full sm:w-auto"
  link_css = "rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400"
  section_label = "eyebrow #{accent[:text]} mb-3"
  section_title = "text-display text-4xl sm:text-5xl text-white text-balance"
  meter_size = [ @game.max_players.to_i, 12 ].min
%>

<div class="bg-slate-900 overflow-x-clip" data-controller="reveal" style="--accent: var(<%= accent[:var] %>)">

  <%# ── Hero ─────────────────────────────────────────────────────────────── %>
  <section class="px-4 sm:px-6 lg:px-8 pt-8 pb-16 sm:pb-24">
    <div class="max-w-6xl mx-auto">
      <nav aria-label="<%= t(".breadcrumb") %>" class="mb-10 text-sm text-slate-400">
        <ol class="flex flex-wrap items-center gap-2">
          <li><%= link_to t("game_pages.home"), root_path, class: "hover:text-white transition-colors #{link_css}" %></li>
          <li aria-hidden="true" class="text-slate-600">/</li>
          <li><%= link_to t("game_pages.games"), games_path, class: "hover:text-white transition-colors #{link_css}" %></li>
          <li aria-hidden="true" class="text-slate-600">/</li>
          <li aria-current="page" class="text-slate-200"><%= @game.name %></li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] gap-14 lg:gap-20 items-center">
        <div class="max-w-2xl">
          <p class="<%= section_label %>"><%= game_category_label(@game) %></p>
          <h1 class="text-display text-5xl sm:text-7xl text-white text-balance mb-6"><%= @game.name %></h1>
          <% if @game.tagline.present? %>
            <p class="font-display text-2xl sm:text-3xl font-bold <%= accent[:soft] %> text-pretty mb-5"><%= @game.tagline %></p>
          <% end %>
          <p class="text-lg text-slate-400 text-pretty mb-8"><%= @game.description %></p>

          <ul class="flex flex-wrap gap-2 mb-10" aria-label="<%= t(".at_a_glance") %>">
            <% [
                 [ :users, game_players_label(@game) ],
                 ([ :clock, t(".about_minutes", count: @game.duration_minutes) ] if @game.duration_minutes),
                 ([ :cake, t(".ages", age: @game.age) ] if @game.age),
                 [ :phone, t(".on_your_phone") ]
               ].compact.each do |icon, label| %>
              <li class="chip py-2 px-4"><%= game_page_icon(icon, css: "size-4 #{accent[:text]}") %><%= label %></li>
            <% end %>
          </ul>

          <div class="flex flex-col sm:flex-row sm:items-center gap-4">
            <%= button_to t(".start_game"), rooms_path(game_id: @game.id), method: :post, class: start_cta, form: select_game_analytics(@game) %>
            <a href="#how-to-play" class="text-center text-purple-300 hover:text-white font-semibold px-4 py-3 transition-colors <%= link_css %>"><%= t(".how_to_play_link") %></a>
          </div>
          <p class="mt-4 text-sm text-slate-500"><%= t(".free_note") %></p>
        </div>

        <%# The game's art on a tilted block of its solid set colour %>
        <figure class="relative mx-auto w-full max-w-[22rem] lg:max-w-none">
          <div aria-hidden="true" class="absolute inset-0 -rotate-6 rounded-[2.5rem] <%= accent[:solid] %> art-dots"></div>
          <div data-controller="tilt" class="relative">
            <%= game_art_tag @game, alt: t(".image_alt", game: @game.name), priority: true,
                  sizes: "(min-width: 1024px) 384px, 352px", class: "w-full aspect-[4/5] object-cover object-top rounded-[2rem] border-[6px] border-slate-900 shadow-2xl shadow-black/50" %>
          </div>
          <% if @game.min_players && @game.max_players %>
            <span aria-hidden="true" class="absolute -left-4 bottom-10 inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 font-display font-extrabold text-slate-950 shadow-xl animate-float [--float-rotate:-4deg]">
              <%= game_page_icon(:users, css: "size-5") %><%= @game.min_players == @game.max_players ? @game.min_players : "#{@game.min_players}–#{@game.max_players}" %>
            </span>
          <% end %>
          <% if @game.duration_minutes %>
            <span aria-hidden="true" class="absolute -right-3 top-8 inline-flex items-center gap-2 rounded-full bg-yellow-400 px-4 py-2 font-display font-extrabold text-slate-950 shadow-xl animate-float [animation-delay:-3s] [--float-rotate:5deg]">
              <%= game_page_icon(:clock, css: "size-5") %><%= t(".minutes_short", count: @game.duration_minutes) %>
            </span>
          <% end %>
        </figure>
      </div>
    </div>
  </section>

  <%# Below the hero image, so on phones it is never right under the Start game button %>
  <%= ad_slot :games, css: "px-4 sm:px-6 lg:px-8 pb-12 max-w-3xl mx-auto" %>

  <%# ── About ────────────────────────────────────────────────────────────── %>
  <% if @game.long_description.present? %>
    <section class="px-4 sm:px-6 lg:px-8 py-20 sm:py-24 border-t border-slate-800" aria-labelledby="about-game">
      <div class="max-w-3xl mx-auto" data-reveal>
        <p class="<%= section_label %>"><%= t(".the_idea") %></p>
        <h2 id="about-game" class="<%= section_title %> mb-6"><%= t(".what_is", game: @game.name) %></h2>
        <p class="text-xl text-slate-300 leading-relaxed text-pretty"><%= @game.long_description %></p>
      </div>
    </section>
  <% end %>

  <%# ── How to play: numbered steps on a line ────────────────────────────── %>
  <% if @game.how_to_play.any? %>
    <section id="how-to-play" class="scroll-mt-20 px-4 sm:px-6 lg:px-8 py-20 sm:py-24 bg-slate-950 border-y border-slate-800" aria-labelledby="how-to-play-title">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] gap-10 lg:gap-16">
        <div class="lg:sticky lg:top-28 self-start" data-reveal>
          <p class="<%= section_label %>"><%= t(".step_by_step") %></p>
          <h2 id="how-to-play-title" class="<%= section_title %>"><%= t(".how_to_play", game: @game.name) %></h2>
        </div>
        <ol class="relative space-y-4 before:absolute before:left-7 before:top-6 before:bottom-6 before:w-0.5 before:bg-slate-800" data-reveal-stagger="90">
          <% @game.how_to_play.each_with_index do |step, i| %>
            <li class="relative flex gap-5 items-start" data-reveal>
              <span class="relative shrink-0 grid place-items-center size-14 rounded-2xl <%= accent[:solid] %> <%= accent[:ink] %> font-display font-extrabold text-2xl tabular-nums shadow-[0_4px_0_rgb(0_0_0/0.35)]" aria-hidden="true"><%= i + 1 %></span>
              <p class="flex-1 rounded-3xl border border-slate-800 bg-slate-900 p-5 sm:p-6 text-slate-200 text-lg text-pretty"><%= step %></p>
            </li>
          <% end %>
        </ol>
      </div>
    </section>
  <% end %>

  <%# ── Players ──────────────────────────────────────────────────────────── %>
  <% if @game.min_players && @game.max_players %>
    <section class="px-4 sm:px-6 lg:px-8 py-20 sm:py-24" aria-labelledby="players-title">
      <div class="max-w-4xl mx-auto grid sm:grid-cols-[auto_1fr] gap-8 sm:gap-14 items-center">
        <div data-reveal>
          <p class="<%= section_label %>"><%= t(".how_many") %></p>
          <h2 id="players-title" class="font-display font-extrabold text-7xl sm:text-8xl text-white tabular-nums leading-none">
            <%= @game.min_players == @game.max_players ? @game.min_players : "#{@game.min_players}–#{@game.max_players}" %>
          </h2>
          <p class="text-slate-400 font-semibold mt-2"><%= t(".players_word") %></p>
        </div>
        <div>
          <div class="flex flex-wrap gap-2 mb-5" role="img" aria-label="<%= game_players_label(@game) %>" data-reveal-stagger="40">
            <% (1..meter_size).each do |n| %>
              <span data-reveal="scale" class="size-8 rounded-full <%= n >= @game.min_players ? accent[:solid] : "bg-slate-800 border-2 border-slate-700" %>"></span>
            <% end %>
            <% if @game.max_players > meter_size %>
              <span data-reveal="scale" class="h-8 px-3 rounded-full bg-slate-800 border-2 border-slate-700 text-sm font-mono font-black text-slate-300 grid place-items-center">+<%= @game.max_players - meter_size %></span>
            <% end %>
          </div>
          <p class="text-slate-300 text-lg text-pretty" data-reveal><%= @game.players_note %></p>
        </div>
      </div>
    </section>
  <% end %>

  <%# ── Tips ─────────────────────────────────────────────────────────────── %>
  <% if @game.tips.any? %>
    <section class="px-4 sm:px-6 lg:px-8 py-20 sm:py-24 border-t border-slate-800" aria-labelledby="tips-title">
      <div class="max-w-6xl mx-auto">
        <div data-reveal>
          <p class="<%= section_label %>"><%= t(".tips_label") %></p>
          <h2 id="tips-title" class="<%= section_title %> mb-12"><%= t(".how_to_win", game: @game.name) %></h2>
        </div>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4" data-reveal-stagger="90" data-reveal-stagger-cols="3">
          <% @game.tips.each do |tip| %>
            <li class="rounded-3xl border border-slate-700 bg-slate-800 p-6 transition-colors hover:border-(--accent)" data-reveal>
              <span class="mb-4 grid place-items-center size-11 rounded-2xl <%= accent[:solid] %> <%= accent[:ink] %>" aria-hidden="true"><%= game_page_icon(:bulb, css: "size-6") %></span>
              <p class="text-slate-200 text-pretty"><%= tip %></p>
            </li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>

  <%# ── Perfect for ──────────────────────────────────────────────────────── %>
  <section class="px-4 sm:px-6 lg:px-8 py-20 sm:py-24 border-t border-slate-800 bg-slate-950" aria-labelledby="perfect-for-title">
    <div class="max-w-6xl mx-auto">
      <div data-reveal>
        <p class="<%= section_label %>"><%= t(".where_it_shines") %></p>
        <h2 id="perfect-for-title" class="<%= section_title %> mb-12"><%= t(".perfect_for") %></h2>
      </div>
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3" data-reveal-stagger="70">
        <% GamePagesHelper::SETTINGS.each do |key, icon| %>
          <% label = t("game_pages.settings.#{key}") %>
          <% fits = @game.perfect_for.include?(key) %>
          <li class="rounded-3xl border-2 p-5 <%= fits ? "bg-slate-900 #{accent[:border]}" : "border-slate-800 border-dashed" %>" data-reveal="scale">
            <span class="mb-4 grid place-items-center size-11 rounded-2xl <%= fits ? "#{accent[:solid]} #{accent[:ink]}" : "bg-slate-900 text-slate-600" %>" aria-hidden="true"><%= game_page_icon(icon, css: "size-6") %></span>
            <p class="font-bold <%= fits ? "text-white" : "text-slate-500" %>"><%= label %></p>
            <p class="text-sm mt-1 <%= fits ? "text-slate-400" : "text-slate-500" %>">
              <% if fits %>
                <span class="inline-flex items-center gap-1"><%= game_page_icon(:check, css: "size-3.5 #{accent[:text]}") %><%= t(".great_fit") %></span>
              <% elsif key == "video_call" %>
                <%= t(".same_room_best") %>
              <% else %>
                <%= t(".not_best") %>
              <% end %>
            </p>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <%# ── FAQ (the answers slide open; application.css) ────────────────────── %>
  <section id="faq" class="scroll-mt-20 px-4 sm:px-6 lg:px-8 py-20 sm:py-24 border-t border-slate-800" aria-labelledby="faq-title">
    <div class="max-w-3xl mx-auto">
      <div data-reveal>
        <p class="<%= section_label %>"><%= t(".questions") %></p>
        <h2 id="faq-title" class="<%= section_title %> mb-12"><%= t(".faq_title", game: @game.name) %></h2>
      </div>
      <div class="space-y-3">
        <% game_faq(@game).each do |item| %>
          <details class="faq group rounded-3xl border-2 border-slate-800 bg-slate-800/60 transition-colors open:border-(--accent) open:bg-slate-800">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none p-5 sm:p-6 font-bold text-white text-lg rounded-3xl [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400">
              <%= item["q"] %>
              <span class="grid place-items-center size-9 shrink-0 rounded-full bg-slate-900 transition-[rotate,background-color] duration-300 group-open:rotate-180 group-open:bg-(--accent)" aria-hidden="true">
                <%= game_page_icon(:chevron, css: "size-5 text-slate-300 group-open:text-slate-950") %>
              </span>
            </summary>
            <p class="px-5 sm:px-6 pb-6 -mt-1 text-slate-400 text-pretty"><%= item["a"] %></p>
          </details>
        <% end %>
      </div>
    </div>
  </section>

  <%= ad_slot :games, css: "px-4 sm:px-6 lg:px-8 py-12 max-w-3xl mx-auto" %>

  <%# ── More games ───────────────────────────────────────────────────────── %>
  <% if @related_games.any? %>
    <section class="px-4 sm:px-6 lg:px-8 py-20 sm:py-24 border-t border-slate-800" aria-labelledby="more-games-title">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-12">
          <h2 id="more-games-title" class="<%= section_title %>"><%= t(".you_might_like") %></h2>
          <%= link_to t(".all_games"), games_path, class: "text-purple-300 hover:text-white font-semibold transition-colors #{link_css}" %>
        </div>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-stagger="90">
          <% @related_games.each do |game| %>
            <li data-reveal="scale"><%= render "games/card", game: game, sizes: "(min-width: 1024px) 360px, (min-width: 640px) 48vw, 100vw" %></li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>

  <%# ── Closing CTA ──────────────────────────────────────────────────────── %>
  <section class="px-4 sm:px-6 lg:px-8 pb-24 sm:pb-32">
    <div class="relative overflow-hidden max-w-6xl mx-auto rounded-[2.5rem] bg-purple-600 px-6 py-16 sm:px-14 sm:py-20 text-center" data-reveal="scale">
      <div aria-hidden="true" class="pointer-events-none">
        <span class="absolute -left-10 -top-10 size-40 rounded-full bg-purple-500"></span>
        <span class="absolute -right-8 -bottom-14 size-52 rounded-full bg-purple-700"></span>
        <span class="absolute right-[12%] top-10 size-10 rounded-full <%= accent[:solid] %> animate-float"></span>
      </div>
      <div class="relative">
        <h2 class="text-display text-4xl sm:text-6xl text-white text-balance mb-5"><%= t(".ready", game: @game.name) %></h2>
        <p class="text-lg sm:text-xl text-purple-100 text-pretty mb-10"><%= t(".ready_text") %></p>
        <%= button_to t(".start_game"), rooms_path(game_id: @game.id), method: :post, class: "btn btn-lg btn-light w-full sm:w-auto", form_class: "flex justify-center",
              form: select_game_analytics(@game) %>
      </div>
    </div>
  </section>

</div>
