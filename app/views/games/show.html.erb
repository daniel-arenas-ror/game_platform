<% content_for :title, t(".title", game: @game.name) %>
<% content_for :description, @game.description %>
<% content_for :og_image, "/games/#{@game.code}/og.png" if File.exist?(Rails.public_path.join("games", @game.code, "og.png")) %>
<% content_for :head do %>
  <script type="application/ld+json"><%= raw json_escape(game_structured_data(@game).to_json) %></script>
<% end %>

<%
  accent = game_accent(@game)
  start_cta = "inline-flex items-center justify-center w-full sm:w-auto bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white text-lg font-black px-10 py-4 rounded-xl shadow-lg shadow-purple-900/20 transition-transform active:scale-95 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400"
  link_css = "rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400"
  section_label = "text-xs font-black uppercase tracking-widest #{accent[:text]} mb-3"
  meter_size = [ @game.max_players.to_i, 12 ].min
%>

<div class="bg-slate-900 overflow-x-clip" data-controller="reveal">

  <%# ── Hero ─────────────────────────────────────────────────────────────── %>
  <section class="px-4 sm:px-6 lg:px-8 pt-8 pb-16 sm:pb-24">
    <div class="max-w-6xl mx-auto">
      <nav aria-label="<%= t(".breadcrumb") %>" class="mb-10 text-sm text-slate-400">
        <ol class="flex flex-wrap items-center gap-2">
          <li><%= link_to t("game_pages.home"), root_path, class: "hover:text-white transition-colors #{link_css}" %></li>
          <li aria-hidden="true" class="text-slate-600">/</li>
          <li><%= link_to t("game_pages.games"), games_path, class: "hover:text-white transition-colors #{link_css}" %></li>
          <li aria-hidden="true" class="text-slate-600">/</li>
          <li aria-current="page" class="text-slate-200"><%= @game.name %></li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-[minmax(0,1fr)_340px] gap-12 lg:gap-16 items-center">
        <div class="max-w-2xl">
          <p class="<%= section_label %>"><%= game_category_label(@game) %></p>
          <h1 class="text-5xl sm:text-6xl font-extrabold tracking-tight text-white text-balance leading-[1.02] mb-5"><%= @game.name %></h1>
          <% if @game.tagline.present? %>
            <p class="text-xl sm:text-2xl font-semibold <%= accent[:soft] %> text-pretty mb-5"><%= @game.tagline %></p>
          <% end %>
          <p class="text-lg text-slate-400 text-pretty mb-8"><%= @game.description %></p>

          <ul class="flex flex-wrap gap-2 mb-10" aria-label="<%= t(".at_a_glance") %>">
            <% [
                 [ :users, game_players_label(@game) ],
                 ([ :clock, t(".about_minutes", count: @game.duration_minutes) ] if @game.duration_minutes),
                 ([ :cake, t(".ages", age: @game.age) ] if @game.age),
                 [ :phone, t(".on_your_phone") ]
               ].compact.each do |icon, label| %>
              <li class="inline-flex items-center gap-2 bg-slate-800 border border-slate-700 rounded-full px-4 py-2 text-sm font-semibold text-slate-200">
                <%= game_page_icon(icon, css: "size-4 #{accent[:text]}") %><%= label %>
              </li>
            <% end %>
          </ul>

          <div class="flex flex-col sm:flex-row sm:items-center gap-4">
            <%= button_to t(".start_game"), rooms_path(game_id: @game.id), method: :post, class: start_cta %>
            <a href="#how-to-play" class="text-center text-purple-400 hover:text-purple-300 font-semibold px-4 py-3 transition-colors <%= link_css %>"><%= t(".how_to_play_link") %></a>
          </div>
          <p class="mt-4 text-sm text-slate-500"><%= t(".free_note") %></p>
        </div>

        <% if game_instruction_image?(@game) %>
          <figure class="max-w-[300px] w-full mx-auto lg:mx-0">
            <%= game_image_tag @game, alt: t(".image_alt", game: @game.name), priority: true,
                  sizes: "300px", class: "w-full rounded-3xl border border-slate-700 shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-500 ease-out motion-reduce:rotate-0" %>
          </figure>
        <% end %>
      </div>
    </div>
  </section>

  <%# Below the hero image, so on phones it is never right under the Start game button %>
  <%= ad_slot :games, css: "px-4 sm:px-6 lg:px-8 pb-12 max-w-3xl mx-auto" %>

  <%# ── About ────────────────────────────────────────────────────────────── %>
  <% if @game.long_description.present? %>
    <section class="px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-t border-slate-800" aria-labelledby="about-game">
      <div class="max-w-3xl mx-auto" data-reveal>
        <p class="<%= section_label %>"><%= t(".the_idea") %></p>
        <h2 id="about-game" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white text-balance mb-6"><%= t(".what_is", game: @game.name) %></h2>
        <p class="text-lg text-slate-300 leading-relaxed text-pretty"><%= @game.long_description %></p>
      </div>
    </section>
  <% end %>

  <%# ── How to play ──────────────────────────────────────────────────────── %>
  <% if @game.how_to_play.any? %>
    <section id="how-to-play" class="scroll-mt-20 px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-t border-slate-800 bg-slate-950/60" aria-labelledby="how-to-play-title">
      <div class="max-w-3xl mx-auto">
        <p class="<%= section_label %>"><%= t(".step_by_step") %></p>
        <h2 id="how-to-play-title" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white text-balance mb-10"><%= t(".how_to_play", game: @game.name) %></h2>
        <ol class="space-y-4">
          <% @game.how_to_play.each_with_index do |step, i| %>
            <li class="flex gap-5 items-start bg-slate-800 border border-slate-700 rounded-2xl p-5 sm:p-6" data-reveal style="--reveal-delay: <%= i * 80 %>ms">
              <span class="shrink-0 grid place-items-center size-11 rounded-xl <%= accent[:tint] %> border <%= accent[:border] %> <%= accent[:text] %> font-mono font-black text-xl tabular-nums" aria-hidden="true"><%= i + 1 %></span>
              <p class="text-slate-200 text-lg text-pretty pt-1.5"><%= step %></p>
            </li>
          <% end %>
        </ol>
      </div>
    </section>
  <% end %>

  <%# ── Players ──────────────────────────────────────────────────────────── %>
  <% if @game.min_players && @game.max_players %>
    <section class="px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-t border-slate-800" aria-labelledby="players-title">
      <div class="max-w-3xl mx-auto grid sm:grid-cols-[auto_1fr] gap-8 sm:gap-12 items-center" data-reveal>
        <div>
          <p class="<%= section_label %>"><%= t(".how_many") %></p>
          <h2 id="players-title" class="font-mono font-black text-5xl sm:text-6xl text-white tabular-nums">
            <%= @game.min_players == @game.max_players ? @game.min_players : "#{@game.min_players}–#{@game.max_players}" %>
          </h2>
          <p class="text-slate-400 font-semibold mt-1"><%= t(".players_word") %></p>
        </div>
        <div>
          <div class="flex flex-wrap gap-1.5 mb-5" role="img" aria-label="<%= game_players_label(@game) %>">
            <% (1..meter_size).each do |n| %>
              <span class="size-6 rounded-full <%= n >= @game.min_players ? accent[:dot] : "bg-slate-700" %>"></span>
            <% end %>
            <% if @game.max_players > meter_size %>
              <span class="h-6 px-2 rounded-full bg-slate-800 border border-slate-700 text-xs font-mono font-black text-slate-300 grid place-items-center">+<%= @game.max_players - meter_size %></span>
            <% end %>
          </div>
          <p class="text-slate-300 text-lg text-pretty"><%= @game.players_note %></p>
        </div>
      </div>
    </section>
  <% end %>

  <%# ── Tips ─────────────────────────────────────────────────────────────── %>
  <% if @game.tips.any? %>
    <section class="px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-t border-slate-800" aria-labelledby="tips-title">
      <div class="max-w-6xl mx-auto">
        <p class="<%= section_label %>"><%= t(".tips_label") %></p>
        <h2 id="tips-title" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white text-balance mb-10"><%= t(".how_to_win", game: @game.name) %></h2>
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @game.tips.each_with_index do |tip, i| %>
            <li class="bg-slate-800 border border-slate-700 rounded-2xl p-6" data-reveal style="--reveal-delay: <%= (i % 3) * 80 %>ms">
              <%= game_page_icon(:bulb, css: "size-6 #{accent[:text]} mb-4") %>
              <p class="text-slate-200 text-pretty"><%= tip %></p>
            </li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>

  <%# ── Perfect for ──────────────────────────────────────────────────────── %>
  <section class="px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-t border-slate-800 bg-slate-950/60" aria-labelledby="perfect-for-title">
    <div class="max-w-6xl mx-auto">
      <p class="<%= section_label %>"><%= t(".where_it_shines") %></p>
      <h2 id="perfect-for-title" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white text-balance mb-10"><%= t(".perfect_for") %></h2>
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        <% GamePagesHelper::SETTINGS.each do |key, icon| %>
          <% label = t("game_pages.settings.#{key}") %>
          <% fits = @game.perfect_for.include?(key) %>
          <li class="rounded-2xl border p-5 <%= fits ? "bg-slate-800 border-slate-700" : "border-slate-800 border-dashed" %>" data-reveal>
            <%= game_page_icon(icon, css: "size-7 mb-3 #{fits ? accent[:text] : "text-slate-600"}") %>
            <p class="font-bold <%= fits ? "text-white" : "text-slate-500" %>"><%= label %></p>
            <p class="text-sm mt-1 <%= fits ? "text-slate-400" : "text-slate-500" %>">
              <% if fits %>
                <span class="inline-flex items-center gap-1"><%= game_page_icon(:check, css: "size-3.5 #{accent[:text]}") %><%= t(".great_fit") %></span>
              <% elsif key == "video_call" %>
                <%= t(".same_room_best") %>
              <% else %>
                <%= t(".not_best") %>
              <% end %>
            </p>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <%# ── FAQ ──────────────────────────────────────────────────────────────── %>
  <section id="faq" class="scroll-mt-20 px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-t border-slate-800" aria-labelledby="faq-title">
    <div class="max-w-3xl mx-auto">
      <p class="<%= section_label %>"><%= t(".questions") %></p>
      <h2 id="faq-title" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white text-balance mb-10"><%= t(".faq_title", game: @game.name) %></h2>
      <div class="space-y-3">
        <% game_faq(@game).each do |item| %>
          <details class="group bg-slate-800 border border-slate-700 rounded-2xl open:border-slate-600">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none p-5 sm:p-6 font-bold text-white text-lg rounded-2xl [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400">
              <%= item["q"] %>
              <%= game_page_icon(:chevron, css: "size-5 shrink-0 text-slate-400 transition-transform group-open:rotate-180") %>
            </summary>
            <p class="px-5 sm:px-6 pb-6 -mt-1 text-slate-400 text-pretty"><%= item["a"] %></p>
          </details>
        <% end %>
      </div>
    </div>
  </section>

  <%= ad_slot :games, css: "px-4 sm:px-6 lg:px-8 py-12 max-w-3xl mx-auto" %>

  <%# ── More games ───────────────────────────────────────────────────────── %>
  <% if @related_games.any? %>
    <section class="px-4 sm:px-6 lg:px-8 py-16 sm:py-20 border-t border-slate-800" aria-labelledby="more-games-title">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
          <h2 id="more-games-title" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white text-balance"><%= t(".you_might_like") %></h2>
          <%= link_to t(".all_games"), games_path, class: "text-purple-400 hover:text-purple-300 font-semibold transition-colors #{link_css}" %>
        </div>
        <ul class="grid sm:grid-cols-3 gap-6">
          <% @related_games.each do |game| %>
            <li data-reveal>
              <%= link_to game_path(game), class: "group block bg-slate-800 border border-slate-700 hover:border-purple-500/70 rounded-2xl overflow-hidden transition-colors h-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400" do %>
                <div class="h-40 bg-slate-700 overflow-hidden">
                  <% if game_instruction_image?(game) %>
                    <%= game_image_tag game, alt: "", card: true, sizes: "(min-width: 640px) 33vw, 100vw",
                          class: "w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-500 ease-out" %>
                  <% end %>
                </div>
                <div class="p-5">
                  <p class="text-lg font-bold text-white text-balance mb-1"><%= game.name %></p>
                  <p class="text-sm text-slate-400 line-clamp-2"><%= game.tagline.presence || game.description %></p>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>

  <%# ── Closing CTA ──────────────────────────────────────────────────────── %>
  <section class="px-4 sm:px-6 lg:px-8 py-20 sm:py-24 border-t border-slate-800 bg-slate-950/60">
    <div class="max-w-2xl mx-auto text-center" data-reveal>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white text-balance mb-4"><%= t(".ready", game: @game.name) %></h2>
      <p class="text-lg text-slate-400 text-pretty mb-8"><%= t(".ready_text") %></p>
      <%= button_to t(".start_game"), rooms_path(game_id: @game.id), method: :post, class: start_cta, form_class: "flex justify-center" %>
    </div>
  </section>

</div>
