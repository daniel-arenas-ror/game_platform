<% content_for :title, t(".title") %>
<% content_for :description, t(".description") %>
<% content_for :head do %>
  <%# Change-game mode belongs to one private room %>
  <% if @room %><meta name="robots" content="noindex, nofollow"><% end %>
  <script type="application/ld+json">
    <%= raw json_escape({
      "@context" => "https://schema.org",
      "@type" => "WebApplication",
      "name" => SeoHelper::SITE_NAME,
      "url" => root_url,
      "description" => t("seo.default_description"),
      "inLanguage" => I18n.locale.to_s,
      "applicationCategory" => "GameApplication",
      "operatingSystem" => t("game_pages.operating_system"),
      "offers" => { "@type" => "Offer", "price" => "0", "priceCurrency" => "USD" },
      "hasPart" => @games.map { |g| { "@type" => "VideoGame", "name" => g.name, "description" => g.description, "url" => (game_url(g) if g.slug.present?) }.compact }
    }.to_json) %>
  </script>
  <% unless @room %>
    <%# The catalog as a list of game pages, so search engines see what the page is a list of %>
    <script type="application/ld+json">
      <%= raw json_escape({
        "@context" => "https://schema.org",
        "@type" => "CollectionPage",
        "name" => page_title,
        "description" => page_description,
        "url" => canonical_url,
        "inLanguage" => I18n.locale.to_s,
        "mainEntity" => {
          "@type" => "ItemList",
          "numberOfItems" => @games.count { |g| g.slug.present? },
          "itemListElement" => @games.select { |g| g.slug.present? }.each_with_index.map { |g, i|
            { "@type" => "ListItem", "position" => i + 1, "url" => game_url(g), "name" => g.name }
          }
        }
      }.to_json) %>
    </script>
    <script type="application/ld+json">
      <%= raw json_escape({
        "@context" => "https://schema.org",
        "@type" => "FAQPage",
        "mainEntity" => t(".faq").map { |item|
          { "@type" => "Question", "name" => item[:q], "acceptedAnswer" => { "@type" => "Answer", "text" => item[:a] } }
        }
      }.to_json) %>
    </script>
  <% end %>
<% end %>

<%
  min_players, max_players = site_players_range(@games)
  categories = GamePagesHelper::CATEGORIES & @games.map(&:category)
  pill_css = "chip cursor-pointer transition-colors hover:border-slate-500 aria-pressed:bg-white aria-pressed:border-white aria-pressed:text-slate-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400"
%>
<div class="bg-slate-900 min-h-screen pt-6 pb-16 sm:pt-10 px-4 sm:px-6 lg:px-8" data-controller="reveal catalog-filter">
  <div class="max-w-7xl mx-auto">

    <header class="mb-8 max-w-3xl">
      <% if @room %>
        <h1 class="text-display text-5xl sm:text-6xl text-white"><%= t(".heading_room") %></h1>
      <% else %>
        <h1 class="text-display text-5xl sm:text-6xl text-white"><%= t(".heading") %></h1>
        <%= render "shared/three_steps", css: "mt-5" %>
        <%= link_to t(".pick_game"), "#games", class: "btn btn-lg w-full sm:w-auto mt-5" %>
        <%# The 3-line summary: what people (and AI assistants sending them here) need first. %>
        <ul id="summary" class="mt-6 space-y-2 text-slate-300 text-pretty">
          <li><%= t(".summary.what_html") %></li>
          <li><%= t(".summary.who_html", min: min_players, max: max_players) %></li>
          <li><%= t(".summary.start_html") %></li>
        </ul>
      <% end %>
    </header>

    <% if @room %>
      <div class="mb-10 bg-slate-800 border-2 border-purple-500/60 rounded-3xl p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <p class="text-white font-bold text-lg">
            <%= t(".changing_html", code: tag.span(@room.code, class: "text-purple-400 font-mono font-black tracking-widest")) %>
          </p>
          <p class="text-slate-400 text-sm"><%= t(".changing_text", game: @room.game.name) %></p>
        </div>
        <%= link_to t(".cancel"), playing_room_path(@room.code),
              class: "text-slate-400 hover:text-white text-sm underline underline-offset-4 transition-colors shrink-0 rounded focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-400" %>
      </div>
    <% end %>

    <div id="games" class="scroll-mt-24"></div>

    <%# Type filter (catalog_filter_controller). Hidden without JS, when every game shows anyway. %>
    <% if categories.size > 1 %>
      <div data-catalog-filter-target="pills" hidden class="mb-8">
        <ul class="flex flex-wrap gap-2" role="group" aria-label="<%= t(".filter_label") %>">
          <% ["all", *categories].each do |category| %>
            <li>
              <button type="button" class="<%= pill_css %>" aria-pressed="<%= category == "all" %>"
                      data-catalog-filter-target="pill" data-category="<%= category %>" data-action="catalog-filter#select">
                <%= t(".filters.#{category}") %>
              </button>
            </li>
          <% end %>
        </ul>
        <p class="sr-only" role="status" data-catalog-filter-target="status"></p>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-stagger="80" data-reveal-stagger-cols="3">
      <% @games.each_with_index do |game, index| %>
        <div data-reveal="scale" data-catalog-filter-target="card" data-category="<%= game.category %>">
          <%# The first row is on screen at once: those load first, the rest when scrolled to %>
          <%= render "games/card", game: game, priority: index < 3, room: @room %>
        </div>
      <% end %>

      <% if @games.empty? %>
        <div class="col-span-full text-center py-20 border-2 border-dashed border-slate-700 rounded-3xl">
          <p class="text-slate-400"><%= t(".empty_html", command: tag.code("bin/rails db:seed", class: "font-mono text-slate-300")) %></p>
        </div>
      <% end %>
    </div>

    <% unless @room %>
      <section id="faq" class="mt-20 max-w-3xl mx-auto [--accent:var(--color-purple-400)]" aria-labelledby="faq-title">
        <h2 id="faq-title" class="text-display text-3xl sm:text-4xl text-white mb-8"><%= t(".faq_title") %></h2>
        <div class="space-y-3">
          <% t(".faq").each do |item| %>
            <details class="faq group rounded-3xl border-2 border-slate-800 bg-slate-800/60 transition-colors open:border-(--accent) open:bg-slate-800">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none p-5 sm:p-6 font-bold text-white text-lg rounded-3xl [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400">
                <%= item[:q] %>
                <span class="grid place-items-center size-9 shrink-0 rounded-full bg-slate-900 transition-[rotate,background-color] duration-300 group-open:rotate-180 group-open:bg-(--accent)" aria-hidden="true">
                  <%= game_page_icon(:chevron, css: "size-5 text-slate-300 group-open:text-slate-950") %>
                </span>
              </summary>
              <p class="px-5 sm:px-6 pb-6 -mt-1 text-slate-400 text-pretty"><%= item[:a] %></p>
            </details>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# Below the game cards with a wide gap, so it is never next to a Play button %>
    <%= ad_slot :games, css: "mt-16 max-w-3xl mx-auto" %>

  </div>
</div>
