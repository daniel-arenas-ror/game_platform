<% content_for :title, t(".title") %>
<% content_for :description, t(".description") %>
<% content_for :head do %>
  <%# Change-game mode belongs to one private room %>
  <% if @room %><meta name="robots" content="noindex, nofollow"><% end %>
  <script type="application/ld+json">
    <%= raw json_escape({
      "@context" => "https://schema.org",
      "@type" => "WebApplication",
      "name" => SeoHelper::SITE_NAME,
      "url" => root_url,
      "description" => t("seo.default_description"),
      "inLanguage" => I18n.locale.to_s,
      "applicationCategory" => "GameApplication",
      "operatingSystem" => t("game_pages.operating_system"),
      "offers" => { "@type" => "Offer", "price" => "0", "priceCurrency" => "USD" },
      "hasPart" => @games.map { |g| { "@type" => "VideoGame", "name" => g.name, "description" => g.description, "url" => (game_url(g) if g.slug.present?) }.compact }
    }.to_json) %>
  </script>
<% end %>

<%
  categories = GamePagesHelper::CATEGORIES & @games.map(&:category)
  pill_css = "chip cursor-pointer transition-colors hover:border-slate-500 aria-pressed:bg-white aria-pressed:border-white aria-pressed:text-slate-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400"
%>
<div class="bg-slate-900 min-h-screen pt-10 pb-16 sm:pt-14 px-4 sm:px-6 lg:px-8" data-controller="reveal catalog-filter">
  <div class="max-w-7xl mx-auto">

    <header class="mb-10 max-w-3xl">
      <% if @room %>
        <h1 class="text-display text-5xl sm:text-6xl text-white"><%= t(".heading_room") %></h1>
      <% else %>
        <h1 class="text-display text-5xl sm:text-7xl text-white"><%= t(".heading") %></h1>
        <p class="mt-5 text-slate-400 text-lg sm:text-xl text-pretty">
          <%= t(".intro") %>
        </p>
      <% end %>
    </header>

    <% if @room %>
      <div class="mb-10 bg-slate-800 border-2 border-purple-500/60 rounded-3xl p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <p class="text-white font-bold text-lg">
            <%= t(".changing_html", code: tag.span(@room.code, class: "text-purple-400 font-mono font-black tracking-widest")) %>
          </p>
          <p class="text-slate-400 text-sm"><%= t(".changing_text", game: @room.game.name) %></p>
        </div>
        <%= link_to t(".cancel"), playing_room_path(@room.code),
              class: "text-slate-400 hover:text-white text-sm underline underline-offset-4 transition-colors shrink-0 rounded focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-400" %>
      </div>
    <% end %>

    <%# Type filter (catalog_filter_controller). Hidden without JS, when every game shows anyway. %>
    <% if categories.size > 1 %>
      <div data-catalog-filter-target="pills" hidden class="mb-8">
        <ul class="flex flex-wrap gap-2" role="group" aria-label="<%= t(".filter_label") %>">
          <% ["all", *categories].each do |category| %>
            <li>
              <button type="button" class="<%= pill_css %>" aria-pressed="<%= category == "all" %>"
                      data-catalog-filter-target="pill" data-category="<%= category %>" data-action="catalog-filter#select">
                <%= t(".filters.#{category}") %>
              </button>
            </li>
          <% end %>
        </ul>
        <p class="sr-only" role="status" data-catalog-filter-target="status"></p>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-stagger="80" data-reveal-stagger-cols="3">
      <% @games.each_with_index do |game, index| %>
        <div data-reveal="scale" data-catalog-filter-target="card" data-category="<%= game.category %>">
          <%# The first row is on screen at once: those load first, the rest when scrolled to %>
          <%= render "games/card", game: game, priority: index < 3, room: @room %>
        </div>
      <% end %>

      <% if @games.empty? %>
        <div class="col-span-full text-center py-20 border-2 border-dashed border-slate-700 rounded-3xl">
          <p class="text-slate-400"><%= t(".empty_html", command: tag.code("bin/rails db:seed", class: "font-mono text-slate-300")) %></p>
        </div>
      <% end %>
    </div>

    <%# Below the game cards with a wide gap, so it is never next to a Play button %>
    <%= ad_slot :games, css: "mt-16 max-w-3xl mx-auto" %>

  </div>
</div>
