<% content_for :title, t(".title") %>
<% content_for :description, t(".description") %>

<div class="bg-slate-900 min-h-[calc(100svh-4rem)] px-4 sm:px-6 lg:px-8 py-10 sm:py-16 flex items-center">
  <div class="w-full max-w-5xl mx-auto grid lg:grid-cols-[minmax(0,28rem)_minmax(0,1fr)] gap-12 lg:gap-20 items-center">

    <section aria-labelledby="join-title" class="w-full max-w-md mx-auto lg:mx-0">
      <h1 id="join-title" class="text-display text-5xl sm:text-6xl text-white text-balance"><%= t(".heading") %></h1>
      <p class="mt-4 text-slate-400 text-lg text-pretty"><%= t(".intro") %></p>

      <%= form_with url: find_room_path, method: :get,
            class: "group mt-8",
            data: { controller: "room-code", action: "submit->room-code#submit", error: (flash[:alert].present? ? "" : nil) } do |f| %>
        <%= f.label :code, t(".code_label"), class: "sr-only" %>
        <div class="relative">
          <%= f.text_field :code,
                value: @code,
                placeholder: t(".code_placeholder"),
                maxlength: 4,
                minlength: 4,
                required: true,
                autofocus: true,
                autocomplete: "off",
                autocapitalize: "characters",
                autocorrect: "off",
                spellcheck: false,
                enterkeyhint: "go",
                aria: { describedby: "room-code-hint", invalid: flash[:alert].present? },
                data: { room_code_target: "input", action: "input->room-code#type focus->room-code#focus blur->room-code#blur" },
                class: "w-full h-20 bg-slate-950 border-2 rounded-2xl px-4 text-white text-center font-mono font-black text-3xl uppercase tracking-[0.5em] placeholder:text-slate-400 placeholder:text-xl placeholder:font-semibold placeholder:tracking-widest focus:border-purple-500 focus:outline-none transition-colors
                        #{flash[:alert] ? "border-red-400/70" : "border-slate-700"}
                        group-data-[enhanced]:absolute group-data-[enhanced]:inset-0 group-data-[enhanced]:h-full group-data-[enhanced]:opacity-0 group-data-[enhanced]:cursor-text" %>

          <%# Visual slots, driven by room_code_controller. Screen readers use the real input above. %>
          <%# Slots pop as they fill, shake on a wrong code and turn green when complete. %>
          <div class="hidden group-data-[enhanced]:grid grid-cols-4 gap-3 pointer-events-none group-data-[error]:animate-shake" aria-hidden="true">
            <% 4.times do %>
              <div data-room-code-target="slot" data-state="empty"
                   class="h-24 sm:h-28 flex items-center justify-center rounded-3xl border-[3px] bg-slate-950 font-mono font-black text-4xl sm:text-5xl text-white transition-colors duration-150
                          border-slate-700 shadow-[0_5px_0_var(--color-slate-950)] data-[state=filled]:border-slate-500 data-[state=active]:border-purple-400 data-[state=active]:bg-purple-500/10
                          data-[state=done]:border-green-400 data-[state=done]:bg-green-500/10 group-data-[error]:border-red-400/70! group-data-[error]:bg-red-500/10!"></div>
            <% end %>
          </div>
        </div>

        <% if flash[:alert] %>
          <p id="room-code-hint" role="alert" class="mt-3 text-red-400 text-sm"><%= flash[:alert] %></p>
        <% else %>
          <p id="room-code-hint" class="mt-3 text-slate-400 text-sm"><%= t(".hint") %></p>
        <% end %>

        <%= f.button t(".submit"), name: nil,
              data: { room_code_target: "submit", label: t(".submit") },
              class: "btn btn-lg mt-6 w-full" %>
      <% end %>

      <ul class="mt-8 flex flex-wrap gap-2">
        <% t("perks").values_at(:no_app, :no_sign_up, :free).each do |perk| %>
          <li class="chip">
            <svg class="size-4 text-green-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <%= perk %>
          </li>
        <% end %>
      </ul>
    </section>

    <aside aria-labelledby="where-title" class="w-full max-w-md mx-auto lg:max-w-none">
      <h2 id="where-title" class="text-2xl font-extrabold text-white"><%= t(".where_title") %></h2>
      <p class="mt-2 text-slate-400 text-pretty"><%= t(".where_text") %></p>

      <%# A miniature of the host lobby, with the room code called out %>
      <figure class="mt-6">
        <div class="rounded-3xl border border-slate-700 bg-slate-800 p-2.5 shadow-2xl shadow-black/40 -rotate-1">
          <div class="aspect-video rounded-2xl bg-slate-950 p-4 sm:p-6 flex items-center gap-4 sm:gap-6 overflow-hidden">
            <div class="flex-1 min-w-0">
              <p class="font-display text-white font-extrabold text-sm sm:text-xl truncate"><%= t("mock_game_name") %></p>
              <p class="relative mt-2 sm:mt-3 inline-block font-mono font-bold text-purple-300 text-sm sm:text-xl rounded-lg border-2 border-purple-400 px-2 py-0.5">
                <span aria-hidden="true" class="absolute -inset-0.5 rounded-lg border-2 border-purple-400 motion-safe:animate-ping"></span>
                <%= t("home.index.mock_room", code: Room::EXAMPLE_CODE) %>
              </p>
              <div class="mt-4 sm:mt-6 space-y-1.5" aria-hidden="true">
                <div class="h-2 w-3/4 rounded-full bg-slate-800"></div>
                <div class="h-2 w-1/2 rounded-full bg-slate-800"></div>
              </div>
            </div>
            <div class="shrink-0 rounded-lg bg-white p-1.5 sm:p-2.5"><%= render "home/qr", css: "size-16 sm:size-24" %></div>
          </div>
        </div>
        <figcaption class="mt-6 flex items-start gap-4 rounded-3xl border border-slate-700 bg-slate-800 p-5 text-slate-400 text-pretty">
          <span class="grid place-items-center size-11 shrink-0 rounded-2xl bg-pink-600 text-white" aria-hidden="true">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
          </span>
          <span class="pt-1"><%= t(".faster_html") %></span>
        </figcaption>
      </figure>

      <p class="mt-10 text-sm text-slate-400">
        <%= t(".hosting") %>
        <%= link_to games_path, class: "text-purple-300 hover:text-white font-semibold underline underline-offset-4 decoration-purple-500/50 hover:decoration-white rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400" do %><%= t(".pick_game") %><% end %>
      </p>
    </aside>

  </div>
</div>
