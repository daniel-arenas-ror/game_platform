<%# Christmas party games (all year, not only in Christmas mode). Keep christmas.es.html.erb in sync. %>
<% games_link = link_to games_url.sub(%r{\Ahttps?://}, ""), games_path, class: "text-purple-400 hover:text-purple-300 underline" %>
<% occasions = {
     family:     [ "🎄 Christmas dinner with the family", "For grandparents and kids at the same table: quick rules, nobody is left out, and every round is short." ],
     office:     [ "🎁 Office Christmas party", "Trivia, teamwork and a little friendly suspicion, so colleagues get talking." ],
     kids:       [ "⛄ Kids and the last class before the holidays", "Easy to pick up, fast to play, and something for every child at once." ],
     video_call: [ "📞 Family on a video call", "Share the game screen on the call, and everyone joins from their own phone, wherever they are." ]
   } %>
<%# Shown on the page and sent as FAQPage structured data, so both always say the same. %>
<% faq = [
     [ "What are good Christmas games for a big group?",
       "Games where everyone plays at once, so nobody waits for their turn. On #{SeoHelper::SITE_NAME} the game shows on one TV or laptop and each player answers on their own phone, with room for up to 30 players in many games." ],
     [ "Is there a Christmas trivia game?",
       "Yes. How to Be a Billionaire has a Christmas topic with questions on traditions, songs, films, food and the history of Christmas. Pick 🎄 Christmas in the game's settings." ],
     [ "Is there a Christmas drawing game?",
       "Yes. Doodle Dash has a Christmas word pack: Santa, reindeer, a snowman, a Christmas tree, presents and more. One player draws on their phone and the others guess." ],
     [ "Can family members far away play too?",
       "Yes. Players join over the internet with a 4-letter room code, so it works on a video call: the host shares the game screen and everyone plays on their phone." ],
     [ "Do we need to download an app or sign up?",
       "No. Players scan a QR code with their phone camera and type a nickname. There is nothing to install and no account, not even for the host." ],
     [ "Are the games suitable for children?",
       "Yes. The games are made for ages 8 and up, so the whole family can play together." ],
     [ "Is it free?",
       "Yes. Every game is free, with no payments or in-game purchases." ]
   ] %>
<% content_for :title, "Christmas Party Games for Groups" %>
<% content_for :description, "Free Christmas party games for family dinners, office parties and classrooms: one TV shows the game and everyone plays on their phone. Christmas trivia and drawing. No app, no sign-up." %>
<% content_for :head do %>
  <script type="application/ld+json"><%= raw json_escape(christmas_structured_data(faq, @occasions.values.flatten.uniq).to_json) %></script>
<% end %>

<div class="min-h-screen py-12 px-4 sm:px-6">
  <article class="max-w-5xl mx-auto text-slate-300 leading-relaxed space-y-14">
    <div class="max-w-3xl">
      <%= render "pages/header", title: "Christmas party games for the whole group", subtitle: "One TV, everyone's phone, and games that the grandparents and the kids can play together." %>
      <ul id="summary" class="space-y-2 rounded-2xl bg-slate-800 border border-slate-700 p-6 text-lg text-white">
        <li><strong>What it is:</strong> free party games for Christmas get-togethers. The game shows on a TV or laptop, and everyone plays on their phone at the same time.</li>
        <li><strong>Christmas packs:</strong> Christmas trivia, drawing, word and color games, plus games for any group.</li>
        <li><strong>How to start:</strong> open <%= games_link %> on the big screen and press Start game. Players scan the QR code. No app and no sign-up.</li>
      </ul>
      <%= render "shared/three_steps", css: "mt-6" %>
    </div>

    <section class="space-y-6" aria-labelledby="packs-title">
      <h2 id="packs-title" class="text-3xl font-bold text-white">Christmas packs</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <% [ [ @billionaire, "Christmas trivia", "#{@christmas_questions.positive? ? @christmas_questions : "Lots of"} Christmas questions on traditions, songs, films, food and the history of Christmas. In the game's settings, pick 🎄 Christmas as the topic." ],
             [ @doodle_dash, "Christmas drawing", "30 Christmas words to draw and guess: Santa, reindeer, a snowman, a Christmas tree, presents, stockings and more. In the game's settings, pick the 🎄 Christmas pack." ],
             [ @christmas_packs[0], "Christmas words", "16 Christmas categories, like \"Things you hang on a Christmas tree\" or \"Christmas songs\": everyone tries to write the same word. In the game's settings, pick 🎄 Christmas as the categories." ],
             [ @christmas_packs[1], "Christmas alphabet", "A Christmas clue for every letter: \"Starts with S: Santa's flying sled\". In the game's settings, pick 🎄 Christmas as the words." ],
             [ @christmas_packs[2], "Christmas colors", "Mix the color of Santa's suit, a candy cane or the gold star on the tree from memory. In the game's settings, pick the 🎄 Christmas mode." ] ].each do |game, label, text| %>
          <% next unless game %>
          <div class="flex flex-col gap-4 rounded-3xl border border-slate-700 bg-slate-800 p-6">
            <p class="eyebrow text-green-400"><%= label %></p>
            <h3 class="text-2xl font-bold text-white"><%= link_to game.name, game_path(game), class: "hover:underline underline-offset-4" %></h3>
            <p><%= text %></p>
            <%= link_to "Play #{game.name}", game_path(game), class: "btn btn-sm self-start" %>
          </div>
        <% end %>
      </div>
    </section>

    <% occasions.each do |key, (heading, text)| %>
      <% next if @occasions[key].blank? %>
      <section class="space-y-6" aria-labelledby="<%= key %>-title">
        <div class="max-w-3xl">
          <h2 id="<%= key %>-title" class="text-3xl font-bold text-white"><%= heading %></h2>
          <p class="mt-2"><%= text %></p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @occasions[key].each do |game| %>
            <%= render "games/card", game: game, priority: false %>
          <% end %>
        </div>
      </section>
    <% end %>

    <section class="max-w-3xl space-y-4" aria-labelledby="faq-title">
      <h2 id="faq-title" class="text-3xl font-bold text-white">Questions</h2>
      <% faq.each do |question, answer| %>
        <details class="group rounded-2xl border border-slate-700 bg-slate-800 p-5">
          <summary class="cursor-pointer font-bold text-white"><%= question %></summary>
          <p class="mt-3"><%= answer %></p>
        </details>
      <% end %>
    </section>

    <div class="max-w-3xl">
      <%= link_to "See all the games", games_path, class: "btn btn-lg" %>
    </div>
  </article>
  <%= ad_slot :page, css: "max-w-3xl mx-auto mt-12" %>
</div>
