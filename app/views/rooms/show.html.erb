<div data-controller="game-subscription" 
     data-game-subscription-room-code-value="<%= @room.code %>"
     data-game-subscription-user-id-value="<%= current_player&.id %>"
     data-game-subscription-host-value="<%= current_player.nil? %>"
     data-game-subscription-players-url-value="<%= players_room_path(@room.code) %>">

  <div class="bg-slate-900 min-h-screen text-white p-8 flex flex-col items-center">
    <div class="max-w-4xl w-full grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      
      <!-- Left Side: Game Info & QR -->
      <div class="text-center md:text-left">
        <h1 class="text-4xl font-black mb-2"><%= @game.name %></h1>
        <p class="text-purple-400 font-mono text-2xl mb-8"><%= t(".room", code: @room.code) %></p>
        
        <div class="bg-white p-4 rounded-2xl inline-block mb-4 shadow-2xl">
          <% if current_player.nil? %>
            <%= @svg.html_safe %>
          <% elsif game_instruction_image?(@game) %>
            <%= game_image_tag @game, alt: t(".image_alt", game: @game.name), priority: true, sizes: "(min-width: 768px) 360px, 90vw",
                  class: "w-full h-auto max-w-sm" %>
          <% else %>
            <%# No instruction image yet: the game's steps instead %>
            <ol class="list-decimal list-inside space-y-2 text-left text-slate-800 text-sm max-w-xs p-2">
              <% @game.how_to_play.each do |step| %><li><%= step %></li><% end %>
            </ol>
          <% end %>
        </div>
        
        <p class="text-slate-400"><%= t(".scan") %></p>
        <p class="text-xs text-slate-500 mt-2"><%= @join_url %></p>
      </div>

      <!-- Right Side: Player List (ActionCable will update this later) -->
      <div class="bg-slate-800 rounded-3xl p-8 border border-slate-700 shadow-xl min-h-[400px]">
        <h2 class="text-xl font-bold mb-6 flex justify-between">
          <%= t(".players") %>
          <span class="bg-purple-600 text-xs py-1 px-3 rounded-full"><%= t(".waiting") %></span>
        </h2>
        <div id="player-list" data-room-code="<%= @room.code %>" class="space-y-4">
          <!-- We will inject players here with ActionCable -->
          <% @room.players.each do |player| %>
            <div id="player-<%= player.id %>" class="flex items-center space-x-4 bg-slate-700 p-4 rounded-xl border border-slate-600">
              <div class="w-10 h-10 bg-purple-500 rounded-full flex items-center justify-center font-bold">
                <%= player.nickname[0].upcase %>
              </div>
              <div class="text-white font-bold flex-1 min-w-0 truncate"><%= player.nickname %></div>
              <% if current_player.nil? %>
                <button type="button" data-action="game-subscription#remove"
                        data-player-id="<%= player.id %>" data-nickname="<%= player.nickname %>"
                        aria-label="<%= t(".remove_player", name: player.nickname) %>"
                        class="ml-auto shrink-0 rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-1.5 text-sm font-bold text-red-300 hover:bg-red-500/20 disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-red-400"><%= t(".remove") %></button>
              <% end %>
            </div>
          <% end %>
          <div class="flex items-center space-x-4 bg-slate-700/50 p-4 rounded-xl border border-slate-600 animate-pulse">
            <div class="w-10 h-10 bg-slate-600 rounded-full"></div>
            <div class="h-4 w-32 bg-slate-600 rounded"></div>
          </div>
        </div>

        <% if current_player.nil? %>
          <%= button_to start_room_path(@room.code), 
              method: :post, 
              remote: true, 
              class: "w-full mt-12 bg-green-500 hover:bg-green-400 text-slate-900 font-black py-4 rounded-xl uppercase tracking-widest transition-all text-center block" do %>
            <%= t(".start") %>
          <% end %>
        <% end %>
      </div>

    </div>

    <%# Under the whole lobby, far from the Start Game button %>
    <%= ad_slot :lobby, css: "mt-16 max-w-4xl w-full" %>
  </div>
</div>
<%= render "shared/room_players", room: @room %>
