<% pickers = [
     [t(".subject"),   "subject",          "mix",   [["words", t(".subject_words"), t(".subject_words_desc")],
                                                     ["players", t(".subject_players"), t(".subject_players_desc")],
                                                     ["mix", t(".subject_mix"), t(".subject_mix_desc")]]],
     [t(".draw_time"), "draw_time",        "80",    [["40", "40s", t(".sprint")], ["60", "60s", t(".quick")], ["80", "80s", t(".normal")], ["100", "100s", t(".relaxed")]]],
     [t(".turns"),     "turns_per_player", "1",     [["1", "1×", t(".once")], ["2", "2×", t(".twice")], ["3", "3×", t(".three_times")]]],
     [t(".words"),     "difficulty",       "mixed", [["easy", t(".easy"), t(".easy_example")], ["medium", t(".medium"), t(".medium_example")],
                                                     ["hard", t(".hard"), t(".hard_example")], ["mixed", t(".mixed"), t(".mixed_desc")]]],
     [t(".guesses"),   "show_guesses",     "true",  [["true", t(".show"), t(".show_desc")], ["false", t(".hide"), t(".hide_desc")]]]
   ] %>

<%# Where the words come from: a mix of everything (default), the classic lists (by difficulty) or a
    themed pack. The host's own words go on top of any of them. The difficulty picker shows only for
    the classic lists (CSS :has). %>
<% source  = @room.game_state["word_source"].presence || "mix" %>
<% custom  = Array(@room.game_state["custom_words"]).join("\n") %>
<% sources = [ [ "mix", t(".mix"), t(".mix_desc") ],
               [ "classic", t(".classic"), t(".classic_desc") ],
               *GameServices::DoodleDash::PACKS.map { |pack, words| [ pack, t(".packs.#{pack}"), t(".pack_words", count: words["en"].size) ] } ] %>
<div class="group/dd">
<div class="space-y-4 bg-slate-900/50 p-6 rounded-2xl border border-slate-700">
  <label class="block text-xs font-bold text-slate-400 mb-3 tracking-widest"><%= t(".source") %></label>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <% sources.each do |value, label, caption| %>
      <label class="relative cursor-pointer">
        <input type="radio" id="dd-source-<%= value %>" name="room[game_state][word_source]" value="<%= value %>"
               class="peer hidden" <%= "checked" if source == value %>>
        <div class="h-full text-center py-4 px-2 bg-slate-800 border-2 border-slate-700 rounded-xl transition-all
                    peer-checked:border-lime-500 peer-checked:bg-lime-500/10">
          <p class="text-white font-black text-lg"><%= label %></p>
          <p class="text-slate-500 text-xs mt-1"><%= caption %></p>
        </div>
      </label>
    <% end %>
  </div>
  <div class="space-y-2">
    <label for="dd-custom-words" class="block text-xs font-bold text-slate-400 tracking-widest"><%= t(".custom_label") %></label>
    <textarea id="dd-custom-words" name="room[game_state][custom_words]" rows="5"
              placeholder="<%= t(".custom_placeholder") %>"
              class="w-full rounded-xl bg-slate-800 border-2 border-slate-700 focus:border-lime-500 px-4 py-3 text-white font-bold outline-none"><%= custom %></textarea>
    <p class="text-slate-500 text-xs"><%= t(".custom_hint") %></p>
  </div>
</div>

<% pickers.each_with_index do |(title, key, default, options), i| %>
  <div class="space-y-4 bg-slate-900/50 p-6 rounded-2xl border border-slate-700 mt-2 <%= 'hidden group-has-[#dd-source-classic:checked]/dd:block' if key == 'difficulty' %>">
    <label class="block text-xs font-bold text-slate-400 mb-3 tracking-widest"><%= title %></label>
    <div class="grid <%= { 2 => "grid-cols-2", 3 => "grid-cols-3", 4 => "grid-cols-2 sm:grid-cols-4" }[options.length] %> gap-3">
      <% options.each do |value, label, caption| %>
        <label class="relative cursor-pointer">
          <input type="radio"
                 name="room[game_state][<%= key %>]"
                 value="<%= value %>"
                 class="peer hidden"
                 <%= 'checked' if (@room.game_state[key].nil? ? default : @room.game_state[key].to_s) == value %>>
          <div class="text-center py-4 px-2 bg-slate-800 border-2 border-slate-700 rounded-xl transition-all
                      peer-checked:border-lime-500 peer-checked:bg-lime-500/10">
            <p class="text-white font-black text-xl"><%= label %></p>
            <p class="text-slate-500 text-xs mt-1"><%= caption %></p>
          </div>
        </label>
      <% end %>
    </div>
    <% if key == "subject" %>
      <p class="text-slate-500 text-xs"><%= t(".subject_note") %></p>
    <% end %>
    <% if key == "show_guesses" %>
      <p class="text-slate-500 text-xs"><%= t(".rude_note") %></p>
    <% end %>
  </div>
<% end %>
</div>
