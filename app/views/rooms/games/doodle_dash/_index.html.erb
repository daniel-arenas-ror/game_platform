<% is_host = session[:player_id].blank? %>

<% if is_host %>
  <%# ================================================================= %>
  <%# HOST VIEW — big screen / TV: the drawing, the hints, the guesses  %>
  <%# ================================================================= %>
  <div data-controller="doodle-dash-host"
       data-doodle-dash-host-room-code-value="<%= @room.code %>"
       class="relative flex flex-col min-h-screen bg-slate-950 text-white overflow-hidden">

    <%# Header %>
    <div class="flex items-center justify-between px-8 pt-6">
      <h1 class="text-2xl font-black tracking-widest uppercase text-lime-400">✏️ Doodle Dash</h1>
      <p class="text-slate-500 text-xs font-mono tracking-widest">
        Room: <span class="text-white font-bold"><%= @room.code %></span>
        · <span data-doodle-dash-host-target="turnLabel"></span>
      </p>
    </div>

    <div class="flex-1 flex items-center justify-center gap-10 px-8 py-6">
      <%# The word (blanks + hint letters) and the drawing %>
      <div class="flex flex-col items-center gap-5">
        <p data-doodle-dash-host-target="pattern"
           class="min-h-[1.2em] font-mono font-black text-5xl tracking-wide text-white"></p>

        <div class="relative rounded-3xl overflow-hidden border-4 border-slate-700 shadow-2xl bg-white"
             style="width: min(60vw, calc(74vh * 4 / 3)); aspect-ratio: 4 / 3;">
          <canvas data-doodle-dash-host-target="canvas" class="block w-full h-full"></canvas>

          <%# Covers the canvas while a word is chosen and at the reveal %>
          <div data-doodle-dash-host-target="overlay"
               class="absolute inset-0 flex flex-col items-center justify-center bg-slate-950/90 text-center px-10">
            <p data-doodle-dash-host-target="overlayIcon" class="text-7xl mb-4">✏️</p>
            <p data-doodle-dash-host-target="overlayTitle" class="font-black text-4xl text-balance">Get ready…</p>
            <p data-doodle-dash-host-target="overlayHint" class="text-slate-400 text-xl mt-3 text-balance">
              Grab your phones. One of you is about to draw.
            </p>
          </div>
        </div>
      </div>

      <%# Sidebar %>
      <div class="w-80 shrink-0 space-y-5">
        <%# Who is drawing + countdown %>
        <div class="bg-slate-800 rounded-3xl border-2 border-lime-500/40 p-6 text-center">
          <p data-doodle-dash-host-target="artistLabel" class="text-white font-black text-2xl leading-tight">Get ready…</p>
          <p data-doodle-dash-host-target="phaseHint" class="text-slate-400 text-sm mt-2"></p>
          <p data-doodle-dash-host-target="countdown" class="font-mono font-black text-6xl mt-4 tabular-nums"></p>
        </div>

        <%# Leaderboard %>
        <div class="bg-slate-800 rounded-3xl border border-slate-700 p-5">
          <p class="text-slate-400 text-xs uppercase tracking-widest font-mono mb-3">Scores</p>
          <div data-doodle-dash-host-target="scoreboard" class="space-y-2"></div>
        </div>

        <%# Live guesses %>
        <div class="bg-slate-800 rounded-3xl border border-slate-700 p-5">
          <p class="text-slate-400 text-xs uppercase tracking-widest font-mono mb-3">Guesses</p>
          <ul data-doodle-dash-host-target="feed" class="space-y-1.5 text-lg min-h-[8rem]"></ul>
        </div>
      </div>
    </div>

    <%# Toasts ("Ana guessed it! +92") %>
    <div data-doodle-dash-host-target="toasts"
         class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2 pointer-events-none"></div>

    <%# Game over overlay %>
    <div data-doodle-dash-host-target="phaseGameOver"
         class="hidden absolute inset-0 z-30 flex flex-col items-center justify-center bg-slate-950/95">
      <p class="text-6xl mb-4">🏆</p>
      <h2 class="text-5xl font-black text-lime-400 tracking-widest mb-8">GAME OVER</h2>
      <div data-doodle-dash-host-target="finalLeaderboard" class="space-y-3 w-full max-w-sm mb-10"></div>
      <button data-doodle-dash-host-target="playAgain"
              class="bg-lime-400 hover:bg-lime-300 text-slate-950 font-black px-10 py-3
                     rounded-xl uppercase tracking-widest text-lg transition-colors cursor-pointer">
        Play Again
      </button>
      <%= render partial: "rooms/games/change_game", locals: { room: @room, games: @games } %>
      <%= game_over_ad %>
    </div>
  </div>

<% else %>
  <%# ================================================================= %>
  <%# PLAYER VIEW — phone: the artist draws, everyone else types guesses %>
  <%# ================================================================= %>
  <% current_player %>
  <div data-controller="doodle-dash-player"
       data-doodle-dash-player-room-code-value="<%= @room.code %>"
       data-doodle-dash-player-player-id-value="<%= session[:player_id] %>"
       class="flex flex-col min-h-dvh bg-slate-950 text-white">

    <%# Header %>
    <div class="flex items-center justify-between px-4 pt-5 short-landscape:pt-2 pb-2 short-landscape:pb-0">
      <p class="font-black text-lg tracking-wide leading-tight truncate"><%= session[:nickname] %></p>
      <div class="text-right">
        <p class="text-[10px] text-slate-500 uppercase tracking-widest">Points</p>
        <p data-doodle-dash-player-target="score" class="font-mono font-black text-3xl text-lime-400 leading-none">0</p>
      </div>
    </div>

    <%# Status line %>
    <div class="flex items-center justify-between px-4 pb-3 short-landscape:pb-1">
      <p data-doodle-dash-player-target="status" class="text-slate-400 text-xs uppercase tracking-widest font-mono">Get ready…</p>
      <p data-doodle-dash-player-target="countdown" class="font-mono font-black text-2xl tabular-nums"></p>
    </div>

    <div class="flex-1 flex flex-col px-4 pb-4">
      <%# Look at the TV (waiting, someone else choosing) %>
      <div data-doodle-dash-player-target="panelWaiting" class="flex-1 flex flex-col items-center justify-center text-center">
        <p class="text-6xl mb-3">📺</p>
        <p data-doodle-dash-player-target="waitingTitle" class="font-black text-2xl">Look at the TV!</p>
        <p data-doodle-dash-player-target="waitingHint" class="text-slate-400 text-sm mt-2">The game starts in a moment.</p>
      </div>

      <%# Artist: pick a word %>
      <div data-doodle-dash-player-target="panelChoose" class="hidden flex-1 flex flex-col justify-center">
        <p class="text-center font-black text-2xl mb-1">Your turn to draw!</p>
        <p class="text-center text-slate-400 text-sm mb-6">Pick a word. Only you can see it.</p>
        <div data-doodle-dash-player-target="choices" class="space-y-3"></div>
      </div>

      <%# Artist: draw %>
      <%# No text selection or long-press menu while drawing %>
      <%# Sideways phones (short-landscape): canvas on the left, tools on the right %>
      <div data-doodle-dash-player-target="panelDraw"
           class="hidden flex-1 flex flex-col short-landscape:flex-row short-landscape:items-center short-landscape:justify-center short-landscape:gap-6 select-none [-webkit-touch-callout:none]">
        <div class="flex flex-col">
          <p class="text-center text-slate-400 text-xs uppercase tracking-widest font-mono short-landscape:hidden">Draw</p>
          <p data-doodle-dash-player-target="word" class="text-center font-black text-3xl short-landscape:text-xl text-lime-400 mb-3 short-landscape:mb-1"></p>

          <%# Sized so the tools always fit on screen %>
          <div class="mx-auto rounded-2xl overflow-hidden border-2 border-slate-700 bg-white
                      w-[min(100%,calc((100dvh-15rem)*4/3))] short-landscape:w-[calc((100dvh-9rem)*4/3)]"
               style="aspect-ratio: 4 / 3;">
            <canvas data-doodle-dash-player-target="canvas"
                    data-action="pointerdown->doodle-dash-player#penDown pointermove->doodle-dash-player#penMove pointerup->doodle-dash-player#penUp pointercancel->doodle-dash-player#penUp"
                    class="block w-full h-full touch-none select-none"></canvas>
          </div>
          <p class="text-center text-slate-500 text-xs mt-2 short-landscape:hidden">Your drawing shows on the TV. No letters!</p>
        </div>

        <%# Tools %>
        <div class="short-landscape:max-w-[15rem]">
          <div data-doodle-dash-player-target="colors" class="flex flex-wrap justify-center gap-2 mt-4 short-landscape:mt-0"></div>
          <div class="flex flex-wrap items-center justify-center gap-3 mt-3">
            <div data-doodle-dash-player-target="sizes" class="flex gap-2"></div>
            <button type="button" data-action="doodle-dash-player#undo"
                    class="h-12 px-4 rounded-xl bg-slate-800 border border-slate-700 font-bold cursor-pointer active:scale-95 transition-transform">↶ Undo</button>
            <button type="button" data-action="doodle-dash-player#clear"
                    class="h-12 px-4 rounded-xl bg-slate-800 border border-slate-700 font-bold cursor-pointer active:scale-95 transition-transform">Clear</button>
          </div>
        </div>
      </div>

      <%# Guesser: type the word %>
      <div data-doodle-dash-player-target="panelGuess" class="hidden flex-1 flex flex-col justify-center">
        <p class="text-center text-slate-400 text-sm mb-2">Look at the TV and guess the drawing</p>
        <p data-doodle-dash-player-target="pattern" class="text-center font-mono font-black text-3xl mb-6"></p>

        <form data-doodle-dash-player-target="guessForm" data-action="submit->doodle-dash-player#sendGuess" class="flex gap-2">
          <input data-doodle-dash-player-target="guessInput"
                 type="text" maxlength="40" placeholder="Your guess…" aria-label="Your guess"
                 autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="send"
                 class="flex-1 min-w-0 bg-slate-900 border-2 border-slate-700 focus:border-lime-500 rounded-xl px-4 py-4 text-lg text-white font-bold outline-none transition-colors">
          <button type="submit"
                  class="shrink-0 bg-lime-400 hover:bg-lime-300 text-slate-950 font-black px-5 rounded-xl cursor-pointer active:scale-95 transition-transform">Send</button>
        </form>
        <p data-doodle-dash-player-target="feedback" role="status" class="min-h-10 text-center font-black text-2xl mt-5"></p>
      </div>

      <%# Reveal %>
      <div data-doodle-dash-player-target="panelReveal" class="hidden flex-1 flex flex-col items-center justify-center text-center">
        <p class="text-slate-400 text-sm uppercase tracking-widest font-mono">The word was</p>
        <p data-doodle-dash-player-target="revealWord" class="font-black text-4xl text-lime-400 mt-2"></p>
        <p data-doodle-dash-player-target="revealPoints" class="font-black text-2xl mt-6"></p>
      </div>
    </div>

    <%# Game over %>
    <div data-doodle-dash-player-target="phaseGameOver"
         class="hidden fixed inset-0 z-30 flex flex-col items-center justify-center bg-slate-950/95 text-center px-6">
      <p data-doodle-dash-player-target="gameOverIcon" class="text-5xl mb-3">🏆</p>
      <p data-doodle-dash-player-target="gameOverTitle" class="font-black text-3xl tracking-wide mb-4"></p>
      <p data-doodle-dash-player-target="finalScore" class="text-lime-400 font-mono font-black text-5xl"></p>
      <p class="text-slate-500 text-xs mt-1 font-mono">total points</p>
      <p class="text-slate-600 text-xs mt-8 font-mono">Waiting for host to restart…</p>
    </div>

    <p class="text-center text-slate-800 text-[10px] font-mono pb-4">Room: <%= @room.code %></p>
  </div>
<% end %>
