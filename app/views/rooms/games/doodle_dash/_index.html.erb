<% is_host = session[:player_id].blank? %>

<% if is_host %>
  <%# ================================================================= %>
  <%# HOST VIEW — big screen / TV: the drawing, the hints, the guesses  %>
  <%# ================================================================= %>
  <div data-controller="doodle-dash-host"
       data-doodle-dash-host-room-code-value="<%= @room.code %>"
       class="relative flex flex-col min-h-screen bg-slate-950 text-white overflow-hidden">

    <%# Header %>
    <div class="flex items-center justify-between px-8 pt-6">
      <h1 class="text-2xl font-black tracking-widest uppercase text-lime-400">✏️ <%= @room.game.name %></h1>
      <p class="text-slate-500 text-xs font-mono tracking-widest">
        <%= t("rooms.games.shared.room") %> <span class="text-white font-bold"><%= @room.code %></span>
        · <span data-doodle-dash-host-target="turnLabel"></span>
      </p>
    </div>

    <div class="flex-1 flex items-center justify-center gap-10 px-8 py-6">
      <%# The word (blanks + hint letters) and the drawing %>
      <div class="flex flex-col items-center gap-5">
        <p data-doodle-dash-host-target="playerChip"
           class="hidden -mb-2 rounded-full border-2 border-yellow-400 bg-yellow-400/10 px-5 py-1 font-black text-xl text-yellow-300"></p>
        <p data-doodle-dash-host-target="pattern"
           class="min-h-[1.2em] font-mono font-black text-5xl tracking-wide text-white"></p>

        <div class="relative rounded-3xl overflow-hidden border-4 border-slate-700 shadow-2xl bg-white"
             style="width: min(60vw, calc(74vh * 4 / 3)); aspect-ratio: 4 / 3;">
          <canvas data-doodle-dash-host-target="canvas" class="block w-full h-full"></canvas>
          <%# Emoji reactions float up over the drawing %>
          <div data-doodle-dash-host-target="reactions" class="absolute inset-0 overflow-hidden pointer-events-none"></div>

          <%# Covers the canvas while a word is chosen and at the reveal %>
          <div data-doodle-dash-host-target="overlay"
               class="absolute inset-0 flex flex-col items-center justify-center bg-slate-950/90 text-center px-10">
            <p data-doodle-dash-host-target="overlayIcon" class="text-7xl mb-4">✏️</p>
            <p data-doodle-dash-host-target="overlayTitle" class="font-black text-4xl text-balance"><%= t(".get_ready") %></p>
            <p data-doodle-dash-host-target="overlayHint" class="text-slate-400 text-xl mt-3 text-balance">
              <%= t(".grab_phones") %>
            </p>
          </div>
        </div>
      </div>

      <%# Sidebar %>
      <div class="w-80 shrink-0 space-y-5">
        <%# Who is drawing + countdown %>
        <div class="bg-slate-800 rounded-3xl border-2 border-lime-500/40 p-6 text-center">
          <p data-doodle-dash-host-target="artistLabel" class="text-white font-black text-2xl leading-tight"><%= t(".get_ready") %></p>
          <p data-doodle-dash-host-target="phaseHint" class="text-slate-400 text-sm mt-2"></p>
          <p data-doodle-dash-host-target="countdown" class="font-mono font-black text-6xl mt-4 tabular-nums"></p>
        </div>

        <%# Leaderboard %>
        <div class="bg-slate-800 rounded-3xl border border-slate-700 p-5">
          <p class="text-slate-400 text-xs uppercase tracking-widest font-mono mb-3"><%= t(".scores") %></p>
          <div data-doodle-dash-host-target="scoreboard" class="space-y-2"></div>
        </div>

        <%# Live guesses %>
        <div class="bg-slate-800 rounded-3xl border border-slate-700 p-5">
          <p class="text-slate-400 text-xs uppercase tracking-widest font-mono mb-3"><%= t(".guesses") %></p>
          <ul data-doodle-dash-host-target="feed" class="space-y-1.5 text-lg min-h-[8rem]"></ul>
        </div>
      </div>
    </div>

    <%# Toasts ("Ana guessed it! +92") %>
    <div data-doodle-dash-host-target="toasts"
         class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2 pointer-events-none"></div>

    <%# Gallery: every drawing of the game while the phones vote for the best one %>
    <div data-doodle-dash-host-target="phaseGallery"
         class="hidden absolute inset-0 z-30 flex flex-col items-center bg-slate-950/95 px-8 py-6 overflow-y-auto">
      <h2 class="text-4xl font-black text-lime-400 tracking-wide"><%= t(".gallery_title") %></h2>
      <p class="text-slate-300 text-xl mt-2"><%= t(".vote_on_phone") %></p>
      <p class="mt-2 font-mono text-lg text-slate-400">
        <span data-doodle-dash-host-target="galleryCountdown" class="font-black text-lime-400 tabular-nums"></span>
        · <span data-doodle-dash-host-target="galleryVotes"></span>
      </p>
      <div data-doodle-dash-host-target="galleryGrid" class="mt-6 grid grid-cols-3 xl:grid-cols-4 gap-5 w-full max-w-6xl"></div>
    </div>

    <%# Game over overlay %>
    <div data-doodle-dash-host-target="phaseGameOver"
         class="hidden absolute inset-0 z-30 flex flex-col items-center justify-center-safe bg-slate-950/95 overflow-y-auto py-8 *:shrink-0">
      <p class="text-5xl mb-3">🏆</p>
      <h2 class="text-5xl font-black text-lime-400 tracking-widest mb-6"><%= t("rooms.games.shared.game_over") %></h2>
      <div class="flex flex-wrap items-start justify-center gap-10 mb-8">
        <div data-doodle-dash-host-target="finalLeaderboard" class="space-y-3 w-96 max-w-full"></div>
        <%# The vote's winner (none when there was no vote) %>
        <div data-doodle-dash-host-target="bestDrawing" class="hidden w-72"></div>
      </div>
      <%# Every drawing of the game, small %>
      <div data-doodle-dash-host-target="galleryStrip" class="hidden flex justify-center-safe gap-3 overflow-x-auto max-w-5xl w-full px-4 pb-2 mb-8"></div>
      <button data-doodle-dash-host-target="playAgain"
              class="bg-lime-400 hover:bg-lime-300 text-slate-950 font-black px-10 py-3
                     rounded-xl uppercase tracking-widest text-lg transition-colors cursor-pointer">
        <%= t("rooms.games.shared.play_again") %>
      </button>
      <%= render partial: "rooms/games/change_game", locals: { room: @room, games: @games } %>
      <%= game_over_ad %>
    </div>
  </div>

<% else %>
  <%# ================================================================= %>
  <%# PLAYER VIEW — phone: the artist draws, everyone else types guesses %>
  <%# ================================================================= %>
  <% current_player %>
  <div data-controller="doodle-dash-player"
       data-doodle-dash-player-room-code-value="<%= @room.code %>"
       data-doodle-dash-player-player-id-value="<%= session[:player_id] %>"
       class="flex flex-col min-h-dvh bg-slate-950 text-white">

    <%# Header %>
    <div class="flex items-center justify-between px-4 pt-5 short-landscape:pt-2 pb-2 short-landscape:pb-0">
      <p class="font-black text-lg tracking-wide leading-tight truncate"><%= session[:nickname] %></p>
      <div class="text-right">
        <p class="text-[10px] text-slate-500 uppercase tracking-widest"><%= t("rooms.games.shared.points") %></p>
        <p data-doodle-dash-player-target="score" class="font-mono font-black text-3xl text-lime-400 leading-none">0</p>
      </div>
    </div>

    <%# Status line %>
    <div class="flex items-center justify-between px-4 pb-3 short-landscape:pb-1">
      <p data-doodle-dash-player-target="status" class="text-slate-400 text-xs uppercase tracking-widest font-mono"><%= t(".get_ready") %></p>
      <p data-doodle-dash-player-target="countdown" class="font-mono font-black text-2xl tabular-nums"></p>
    </div>

    <div class="flex-1 flex flex-col px-4 pb-4">
      <%# Look at the TV (waiting, someone else choosing) %>
      <div data-doodle-dash-player-target="panelWaiting" class="flex-1 flex flex-col items-center justify-center text-center">
        <p class="text-6xl mb-3">📺</p>
        <p data-doodle-dash-player-target="waitingTitle" class="font-black text-2xl"><%= t(".look_tv") %></p>
        <p data-doodle-dash-player-target="waitingHint" class="text-slate-400 text-sm mt-2"><%= t(".starts_soon") %></p>
      </div>

      <%# Artist: pick a word %>
      <div data-doodle-dash-player-target="panelChoose" class="hidden flex-1 flex flex-col justify-center">
        <p class="text-center font-black text-2xl mb-1"><%= t(".your_turn") %></p>
        <p data-doodle-dash-player-target="chooseTitle" class="text-center text-slate-400 text-sm mb-6"><%= t(".pick_word") %></p>
        <div data-doodle-dash-player-target="choices" class="space-y-3"></div>
      </div>

      <%# Artist: draw %>
      <%# No text selection or long-press menu while drawing %>
      <%# Sideways phones (short-landscape): canvas on the left, tools on the right %>
      <div data-doodle-dash-player-target="panelDraw"
           class="hidden flex-1 flex flex-col short-landscape:flex-row short-landscape:items-center short-landscape:justify-center short-landscape:gap-6 select-none [-webkit-touch-callout:none]">
        <div class="flex flex-col">
          <p class="text-center text-slate-400 text-xs uppercase tracking-widest font-mono short-landscape:hidden"><%= t(".draw") %></p>
          <p data-doodle-dash-player-target="word" class="text-center font-black text-3xl short-landscape:text-xl text-lime-400 mb-3 short-landscape:mb-1"></p>

          <%# Sized so the tools always fit on screen %>
          <div class="relative mx-auto rounded-2xl overflow-hidden border-2 border-slate-700 bg-white
                      w-[min(100%,calc((100dvh-15rem)*4/3))] short-landscape:w-[calc((100dvh-9rem)*4/3)]"
               style="aspect-ratio: 4 / 3;">
            <canvas data-doodle-dash-player-target="canvas"
                    data-action="pointerdown->doodle-dash-player#penDown pointermove->doodle-dash-player#penMove pointerup->doodle-dash-player#penUp pointercancel->doodle-dash-player#penUp"
                    class="block w-full h-full touch-none select-none"></canvas>
            <%# The guessers' reactions, so the artist sees how it's going %>
            <div data-doodle-dash-player-target="reactions" class="absolute inset-0 overflow-hidden pointer-events-none"></div>
          </div>
          <p class="text-center text-slate-500 text-xs mt-2 short-landscape:hidden"><%= t(".no_letters") %></p>
        </div>

        <%# Tools %>
        <div class="short-landscape:max-w-[15rem]">
          <div data-doodle-dash-player-target="colors" class="flex flex-wrap justify-center gap-2 mt-4 short-landscape:mt-0"></div>
          <%# One row on a 360px phone: 3 sizes, the bucket, Undo and Clear as icons %>
          <div class="flex flex-wrap items-center justify-center gap-2 mt-3">
            <div data-doodle-dash-player-target="sizes" class="flex gap-2"></div>
            <button type="button" data-action="doodle-dash-player#undo" aria-label="<%= t(".undo") %>" title="<%= t(".undo") %>"
                    class="size-12 grid place-items-center rounded-xl bg-slate-800 border border-slate-700 text-2xl font-black cursor-pointer active:scale-95 transition-transform">↶</button>
            <button type="button" data-action="doodle-dash-player#clear" aria-label="<%= t(".clear") %>" title="<%= t(".clear") %>"
                    class="size-12 grid place-items-center rounded-xl bg-slate-800 border border-slate-700 text-2xl cursor-pointer active:scale-95 transition-transform">🗑️</button>
          </div>
        </div>
      </div>

      <%# Guesser: type the word %>
      <div data-doodle-dash-player-target="panelGuess" class="hidden flex-1 flex flex-col justify-center">
        <%# Player rounds: the answer is someone in the room %>
        <p data-doodle-dash-player-target="playerBanner"
           class="hidden mb-4 rounded-2xl border-2 border-yellow-400 bg-yellow-400/10 px-4 py-3 text-center font-black text-yellow-300"><%= t(".player_banner") %></p>
        <p class="text-center text-slate-400 text-sm mb-2"><%= t(".guess_hint") %></p>
        <p data-doodle-dash-player-target="pattern" class="text-center font-mono font-black text-3xl mb-6"></p>

        <form data-doodle-dash-player-target="guessForm" data-action="submit->doodle-dash-player#sendGuess" class="flex gap-2">
          <input data-doodle-dash-player-target="guessInput"
                 type="text" maxlength="40" placeholder="<%= t(".guess_placeholder") %>" aria-label="<%= t(".guess_label") %>"
                 autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="send"
                 class="flex-1 min-w-0 bg-slate-900 border-2 border-slate-700 focus:border-lime-500 rounded-xl px-4 py-4 text-lg text-white font-bold outline-none transition-colors">
          <button type="submit"
                  class="shrink-0 bg-lime-400 hover:bg-lime-300 text-slate-950 font-black px-5 rounded-xl cursor-pointer active:scale-95 transition-transform"><%= t(".send") %></button>
        </form>
        <p data-doodle-dash-player-target="feedback" role="status" class="min-h-10 text-center font-black text-2xl mt-5"></p>

        <%# Reactions: float up on the TV and on the artist's phone %>
        <div class="mt-4" role="group" aria-label="<%= t(".react_label") %>">
          <p class="text-center text-slate-500 text-xs uppercase tracking-widest font-mono mb-2"><%= t(".react_label") %></p>
          <div class="flex justify-center gap-2">
            <% GameServices::DoodleDash::REACTIONS.each do |emoji| %>
              <button type="button" data-action="doodle-dash-player#react" data-emoji="<%= emoji %>"
                      class="size-12 rounded-2xl bg-slate-800 border border-slate-700 text-2xl cursor-pointer active:scale-90 transition-transform"><%= emoji %></button>
            <% end %>
          </div>
        </div>
      </div>

      <%# Gallery vote: the drawings are on the TV, numbered like these buttons %>
      <div data-doodle-dash-player-target="panelVote" class="hidden flex-1 flex flex-col justify-center">
        <p class="text-center font-black text-2xl"><%= t(".vote_title") %></p>
        <p class="text-center text-slate-400 text-sm mt-1 mb-5"><%= t(".vote_hint") %></p>
        <div data-doodle-dash-player-target="voteOptions" class="space-y-2"></div>
        <p data-doodle-dash-player-target="voteDone" class="hidden text-center font-black text-2xl text-lime-400"><%= t(".voted") %></p>
      </div>

      <%# Reveal %>
      <div data-doodle-dash-player-target="panelReveal" class="hidden flex-1 flex flex-col items-center justify-center text-center">
        <p data-doodle-dash-player-target="revealLabel" class="text-slate-400 text-sm uppercase tracking-widest font-mono"><%= t(".word_was") %></p>
        <p data-doodle-dash-player-target="revealWord" class="font-black text-4xl text-lime-400 mt-2"></p>
        <p data-doodle-dash-player-target="revealPoints" class="font-black text-2xl mt-6"></p>
      </div>
    </div>

    <%# Game over %>
    <div data-doodle-dash-player-target="phaseGameOver"
         class="hidden fixed inset-0 z-30 flex flex-col items-center justify-center bg-slate-950/95 text-center px-6">
      <p data-doodle-dash-player-target="gameOverIcon" class="text-5xl mb-3">🏆</p>
      <p data-doodle-dash-player-target="gameOverTitle" class="font-black text-3xl tracking-wide mb-4"></p>
      <p data-doodle-dash-player-target="finalScore" class="text-lime-400 font-mono font-black text-5xl"></p>
      <p class="text-slate-500 text-xs mt-1 font-mono"><%= t("rooms.games.shared.total_points") %></p>
      <p data-doodle-dash-player-target="bestDrawingNote" class="hidden mt-6 font-black text-xl text-yellow-300"></p>
      <p class="text-slate-600 text-xs mt-8 font-mono"><%= t("rooms.games.shared.waiting_restart") %></p>
    </div>

    <p class="text-center text-slate-800 text-[10px] font-mono pb-4"><%= t("rooms.games.shared.room") %> <%= @room.code %></p>
  </div>
<% end %>
