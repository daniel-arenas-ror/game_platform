<% is_host = session[:player_id].blank? %>

<% if is_host %>
  <%# ================================================================= %>
  <%# HOST VIEW — big screen / TV                                        %>
  <%# ================================================================= %>
  <div class="flex flex-col items-center justify-center min-h-screen bg-black text-white">

    <div class="mb-4 text-center">
      <h1 class="text-3xl font-black tracking-widest uppercase text-yellow-400">Battle City</h1>
      <p class="text-slate-500 text-xs mt-1 font-mono tracking-widest">
        Room: <span class="text-white font-bold"><%= @room.code %></span>
      </p>
    </div>

    <%# Game canvas + overlays %>
    <div data-controller="battle-city-host"
         data-battle-city-host-room-code-value="<%= @room.code %>"
         class="relative border-2 border-slate-800 rounded-lg overflow-hidden"
         style="width: 520px; height: 520px; background: #0d0d1a;">

      <%# PixiJS canvas appended here by the controller %>

      <%# Countdown overlay %>
      <div id="battle-city-countdown"
           class="hidden absolute inset-0 flex items-center justify-center bg-black/70 z-10 pointer-events-none">
        <span id="battle-city-count"
              class="font-black text-white select-none"
              style="font-size: 130px; text-shadow: 0 0 40px rgba(250,204,21,0.9);">3</span>
      </div>

      <%# Game Over overlay (inside canvas area) %>
      <div id="battle-city-game-over"
           class="hidden absolute inset-0 flex items-center justify-center bg-black/88 z-20">
        <div class="text-center px-8 py-8 w-full">
          <h2 class="font-black text-yellow-400 mb-1 tracking-widest"
              style="font-size: 56px; text-shadow: 0 0 30px rgba(250,204,21,0.7);">
            GAME OVER
          </h2>
          <p id="battle-city-over-reason"
             class="text-slate-400 text-xs font-mono uppercase tracking-widest mb-6"></p>

          <div id="battle-city-rankings" class="space-y-2 mb-8 text-left max-w-xs mx-auto"></div>

          <button id="battle-city-play-again"
                  class="bg-yellow-400 hover:bg-yellow-300 text-slate-950 font-black px-10 py-3 rounded-xl uppercase tracking-widest text-lg transition-colors cursor-pointer">
            PLAY AGAIN
          </button>
        </div>
      </div>
    </div>

    <%# Per-player live scoreboards %>
    <div class="mt-5 flex gap-4 flex-wrap justify-center">
      <% tank_colors = %w[text-yellow-400 text-green-400 text-slate-300 text-red-400] %>
      <% @room.players.each_with_index do |player, i| %>
        <div class="bg-slate-900 border border-slate-700 rounded-xl px-5 py-3 text-center min-w-[100px]">
          <p class="text-[10px] text-slate-600 uppercase tracking-widest">Player <%= i + 1 %></p>
          <p class="<%= tank_colors[i] %> font-bold mt-1 text-sm"><%= player.nickname %></p>
          <p class="<%= tank_colors[i] %> font-mono font-black text-2xl" id="score-<%= player.id %>">0</p>
        </div>
      <% end %>
    </div>
  </div>

<% else %>
  <%# ================================================================= %>
  <%# PLAYER VIEW — mobile phone                                         %>
  <%# ================================================================= %>
  <% current_player %>
  <div data-controller="battle-city-player"
       data-battle-city-player-room-code-value="<%= @room.code %>"
       data-battle-city-player-player-id-value="<%= session[:player_id] %>"
       class="relative flex flex-col min-h-screen bg-slate-950 text-white select-none overflow-hidden"
       style="touch-action: none;">

    <%# Countdown overlay %>
    <div data-battle-city-player-target="countdownOverlay"
         class="hidden absolute inset-0 flex items-center justify-center bg-black/80 z-20 pointer-events-none">
      <span data-battle-city-player-target="statusText"
            class="font-black text-white"
            style="font-size: 120px; text-shadow: 0 0 40px rgba(250,204,21,0.9);">3</span>
    </div>

    <%# Game Over overlay — covers phone screen %>
    <div data-battle-city-player-target="gameOverOverlay"
         class="hidden absolute inset-0 z-30 flex flex-col items-center justify-center bg-slate-950 px-8 text-center">
      <p data-battle-city-player-target="gameOverTitle"
         class="font-black tracking-widest"
         style="font-size: 64px; text-shadow: 0 0 30px rgba(250,204,21,0.7);">
        GAME OVER
      </p>
      <p data-battle-city-player-target="gameOverSub"
         class="text-slate-400 text-sm font-mono uppercase tracking-widest mt-2 mb-8"></p>
      <div class="bg-slate-800 border border-slate-700 rounded-2xl px-8 py-4">
        <p class="text-[10px] text-slate-500 uppercase tracking-widest">Your kills</p>
        <p data-battle-city-player-target="finalScore"
           class="font-mono font-black text-5xl text-yellow-400 mt-1">0</p>
      </div>
      <p class="text-slate-600 text-xs mt-10 font-mono">Waiting for host to restart…</p>
    </div>

    <%# Header — color badge, nickname, kill score %>
    <div class="flex items-center justify-between px-6 pt-6 pb-2">
      <div class="flex items-center gap-3">
        <div data-battle-city-player-target="colorBadge"
             class="w-5 h-5 rounded-full border-2 border-slate-600"
             style="background-color: #888;"></div>
        <span class="font-black text-lg tracking-wide"><%= session[:nickname] %></span>
      </div>
      <div class="text-right">
        <p class="text-[10px] text-slate-600 uppercase tracking-widest">Kills</p>
        <p data-battle-city-player-target="score"
           class="font-mono font-black text-3xl text-white leading-none">0</p>
      </div>
    </div>

    <%# D-pad %>
    <div class="flex-1 flex items-center justify-center" data-battle-city-player-target="dpad">
      <div class="grid gap-3"
           style="grid-template-columns: repeat(3, 88px); grid-template-rows: repeat(3, 88px);">

        <div></div>
        <button class="rounded-2xl bg-slate-800 border-2 border-slate-600 flex items-center justify-center text-4xl font-black text-white"
                data-direction="up"
                style="touch-action: none; -webkit-user-select: none; user-select: none;">▲</button>
        <div></div>

        <button class="rounded-2xl bg-slate-800 border-2 border-slate-600 flex items-center justify-center text-4xl font-black text-white"
                data-direction="left"
                style="touch-action: none; -webkit-user-select: none; user-select: none;">◀</button>
        <button class="rounded-2xl border-2 flex items-center justify-center"
                data-fire="true"
                style="background: #c0392b; border-color: #e74c3c; touch-action: none; -webkit-user-select: none; user-select: none;">
          <span style="font-size: 32px;">🔥</span>
        </button>
        <button class="rounded-2xl bg-slate-800 border-2 border-slate-600 flex items-center justify-center text-4xl font-black text-white"
                data-direction="right"
                style="touch-action: none; -webkit-user-select: none; user-select: none;">▶</button>

        <div></div>
        <button class="rounded-2xl bg-slate-800 border-2 border-slate-600 flex items-center justify-center text-4xl font-black text-white"
                data-direction="down"
                style="touch-action: none; -webkit-user-select: none; user-select: none;">▼</button>
        <div></div>
      </div>
    </div>

    <p class="text-center text-slate-800 text-[10px] font-mono pb-4">Room: <%= @room.code %></p>
  </div>
<% end %>
