<% is_host = session[:player_id].blank? %>

<% if is_host %>
  <%# ================================================================= %>
  <%# HOST VIEW — big screen / TV                                        %>
  <%# ================================================================= %>
  <div class="flex flex-col items-center justify-center min-h-screen bg-black text-white">
    <div class="mb-6 text-center">
      <h1 class="text-4xl font-black tracking-widest uppercase text-yellow-400">Battle City</h1>
      <p class="text-slate-400 text-sm mt-1 tracking-widest">Room: <span class="font-mono font-bold text-white"><%= @room.code %></span></p>
    </div>

    <%# Canvas placeholder — replaced by PixiJS in Phase 2 %>
    <div class="relative bg-slate-900 border-4 border-slate-700 rounded-lg"
         style="width: 520px; height: 520px;">
      <div class="absolute inset-0 flex flex-col items-center justify-center space-y-4">
        <div class="w-16 h-16 border-4 border-t-yellow-400 border-slate-700 rounded-full animate-spin"></div>
        <p class="text-slate-400 font-mono text-sm tracking-widest uppercase">Loading game…</p>
      </div>
    </div>

    <%# Scoreboard placeholder %>
    <div class="mt-6 flex gap-6">
      <% @room.players.each_with_index do |player, i| %>
        <div class="bg-slate-800 border border-slate-700 rounded-xl px-5 py-3 text-center">
          <p class="text-xs text-slate-500 uppercase tracking-widest">Player <%= i + 1 %></p>
          <p class="text-white font-bold mt-1"><%= player.nickname %></p>
          <p class="text-yellow-400 font-mono font-black text-xl">0</p>
        </div>
      <% end %>
    </div>
  </div>

<% else %>
  <%# ================================================================= %>
  <%# PLAYER VIEW — mobile phone                                         %>
  <%# ================================================================= %>
  <% current_player %>
  <div class="flex flex-col items-center justify-between min-h-screen bg-slate-950 text-white p-6 select-none">

    <%# Header %>
    <div class="text-center pt-4">
      <p class="text-xs text-slate-500 uppercase tracking-widest">Battle City</p>
      <h2 class="text-xl font-black text-yellow-400 mt-1"><%= session[:nickname] %></h2>
    </div>

    <%# Waiting message — will be replaced with D-pad in Phase 4 %>
    <div class="flex flex-col items-center justify-center flex-1 space-y-4">
      <div class="w-12 h-12 border-4 border-t-yellow-400 border-slate-700 rounded-full animate-spin"></div>
      <p class="text-slate-400 text-sm font-mono tracking-widest uppercase">Game starting…</p>
      <p class="text-slate-600 text-xs">Wait for the host to begin</p>
    </div>

    <%# Room code reminder %>
    <p class="text-slate-700 text-xs font-mono pb-4">Room: <%= @room.code %></p>
  </div>
<% end %>
