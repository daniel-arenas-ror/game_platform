<div data-controller="millionaire"
     data-millionaire-status-value="loading"
     data-millionaire-room-code-value="<%= @room.code %>"
     data-millionaire-player-id-value="<%= session[:player_id] %>"
     class="relative min-h-dvh bg-radial-at-b from-slate-950 via-blue-950 to-slate-950 text-white p-3 sm:p-6 flex flex-col justify-between selection:bg-yellow-500/30">

  <!-- ================================================================= -->
  <!-- SECTION 1: LOADING -->
  <!-- ================================================================= -->
  <div data-millionaire-target="loading" class="flex-1 flex flex-col items-center justify-center min-h-[60vh] space-y-6">
    <div class="relative w-24 h-24">
      <div class="absolute inset-0 rounded-full border-4 border-blue-500/20"></div>
      <div class="absolute inset-0 rounded-full border-4 border-t-yellow-400 border-r-transparent animate-spin"></div>
    </div>
    <div class="text-center space-y-2">
      <h2 class="text-2xl font-black uppercase tracking-widest bg-gradient-to-r from-yellow-400 to-amber-200 bg-clip-text text-transparent"><%= t(".preparing") %></h2>
      <p class="text-sm text-blue-400 animate-pulse font-medium"><%= t(".vault") %></p>
    </div>
  </div>

  <!-- ================================================================= -->
  <!-- SECTION 2: QUESTION — host / TV view (no answer tiles) -->
  <!-- ================================================================= -->
  <div data-millionaire-target="question" class="hidden flex-1 flex flex-col justify-center max-w-4xl mx-auto w-full space-y-12 my-auto">
    <div class="relative bg-gradient-to-b from-blue-900/80 to-slate-900/90 border-y-2 border-blue-500/50 p-8 text-center shadow-2xl backdrop-blur-md">
      <div class="absolute left-0 top-1/2 -translate-y-1/2 w-4 h-1 bg-blue-500"></div>
      <div class="absolute right-0 top-1/2 -translate-y-1/2 w-4 h-1 bg-blue-500"></div>
      <p data-millionaire-target="questionMeta" class="text-xs font-bold text-blue-400 uppercase tracking-widest mb-2"></p>
      <h2 data-millionaire-target="questionText" class="text-2xl md:text-3xl font-bold tracking-wide leading-relaxed">
        <%= t(".loading_question") %>
      </h2>
    </div>
    <p data-millionaire-target="countdown"
       class="text-center font-mono font-black text-7xl text-yellow-400 tabular-nums"></p>
    <p class="text-center text-slate-600 text-xs font-mono tracking-widest uppercase"><%= t(".players_selecting") %></p>
  </div>

  <!-- ================================================================= -->
  <!-- SECTION 3: INPUT — player phone view: only the answers, filling the screen.  -->
  <!-- The question is read on the TV.                                              -->
  <!-- ================================================================= -->
  <div data-millionaire-target="input" class="hidden flex-1 flex flex-col w-full max-w-2xl mx-auto gap-3">

    <%# The label and the "locked" message share one line so locking in doesn't move the answers. %>
    <div class="flex items-center justify-between gap-3 px-1">
      <p data-millionaire-target="lockLabel" class="text-xs font-black tracking-widest text-blue-400 uppercase"><%= t(".lock_in") %></p>
      <p data-millionaire-target="lockedMessage"
         class="hidden text-green-400 font-black tracking-widest text-xs uppercase">
        <%= t(".locked") %>
      </p>
      <p data-millionaire-target="countdown" class="font-mono font-black text-2xl text-yellow-400 tabular-nums"></p>
    </div>

    <div class="flex-1 grid grid-rows-4 gap-3">
      <% %w[A B C D].each_with_index do |letter, idx| %>
        <button data-action="click->millionaire#selectOption" data-option="<%= idx %>"
                class="w-full h-full min-h-0 text-left bg-gradient-to-r from-blue-950 to-slate-900 border-2 border-blue-800 px-5 rounded-2xl
                       transition-all duration-200 hover:border-yellow-400 active:scale-[0.99] flex items-center gap-4 group">
          <span class="text-yellow-400 font-mono font-black text-2xl sm:text-3xl shrink-0"><%= letter %>:</span>
          <span data-millionaire-target="option<%= letter %>"
                class="font-bold text-xl sm:text-2xl leading-snug text-slate-100 group-hover:text-white line-clamp-3"></span>
        </button>
      <% end %>
    </div>
  </div>

  <!-- ================================================================= -->
  <!-- SECTION 4: REVEAL — shown to both host and players after timer -->
  <!-- ================================================================= -->
  <div data-millionaire-target="reveal" class="hidden flex-1 flex flex-col items-center max-w-2xl mx-auto w-full gap-3 sm:gap-4 sm:pb-8 my-auto">

    <p data-millionaire-target="revealRoundLabel"
       class="text-xs font-bold text-blue-400 uppercase tracking-widest"></p>

    <%# Answer tiles — JS colors them correct/wrong/neutral %>
    <div class="grid grid-cols-1 gap-2 w-full font-mono">
      <% [%w[A 0], %w[B 1], %w[C 2], %w[D 3]].each do |letter, idx| %>
        <div data-millionaire-target="revealOption"
             data-option-index="<%= idx %>"
             class="flex items-center border-2 border-slate-700 px-4 py-3 sm:p-4 rounded-2xl gap-3 transition-all duration-300">
          <span class="text-yellow-400 font-black w-6"><%= letter %>:</span>
          <span data-millionaire-target="revealOptionText" class="flex-1 font-sans font-bold text-slate-200"></span>
          <span data-millionaire-target="revealOptionIcon" class="text-base w-6 text-right"></span>
        </div>
      <% end %>
    </div>

    <%# Player result (shown for players, hidden for host) %>
    <div data-millionaire-target="revealPlayerResult"
         class="hidden text-center w-full bg-slate-800/60 rounded-2xl p-4 sm:p-5 border border-slate-700">
      <p data-millionaire-target="revealResultText" class="text-2xl font-black mb-1"></p>
      <p data-millionaire-target="revealTotalText" class="text-sm text-slate-400 font-mono"></p>
    </div>

    <%# Host round scores (shown for host, hidden for players) %>
    <div data-millionaire-target="revealHostScores"
         class="hidden w-full space-y-2"></div>

    <%# What comes next: a countdown ("auto" mode), the host's Next button or "waiting for the host" ("manual"). %>
    <p data-millionaire-target="nextInfo" class="hidden text-center text-xs font-bold uppercase tracking-widest text-blue-400"></p>
    <% if session[:player_id].blank? %>
      <button data-millionaire-target="nextButton" data-action="click->millionaire#nextQuestion"
              class="hidden bg-gradient-to-b from-yellow-300 to-amber-500 hover:from-yellow-200 hover:to-amber-400 text-slate-950
                     font-black px-10 py-3 rounded-xl uppercase tracking-widest text-lg transition-colors cursor-pointer
                     disabled:opacity-50 disabled:cursor-wait">
        <%= t(".next_question") %>
      </button>
    <% end %>

  </div>

  <!-- ================================================================= -->
  <!-- SECTION 5: LEADERBOARD — final standings -->
  <!-- ================================================================= -->
  <div data-millionaire-target="leaderboard" class="hidden flex-1 flex flex-col justify-center max-w-xl mx-auto w-full my-auto space-y-8">
    <div class="text-center">
      <h2 class="text-4xl font-black bg-gradient-to-b from-yellow-300 via-amber-400 to-amber-600 bg-clip-text text-transparent italic tracking-wider uppercase"><%= t(".leaderboard") %></h2>
      <p class="text-xs tracking-widest text-blue-400 font-bold uppercase mt-1"><%= t(".final_standings") %></p>
    </div>

    <div data-millionaire-target="leaderboardList" class="space-y-3"></div>

    <% if session[:player_id].blank? %>
      <div class="flex flex-col items-center">
        <button data-action="click->millionaire#restartGame"
                class="bg-gradient-to-b from-yellow-300 to-amber-500 hover:from-yellow-200 hover:to-amber-400 text-slate-950
                       font-black px-10 py-3 rounded-xl uppercase tracking-widest text-lg transition-colors cursor-pointer">
          <%= t(".play_again") %>
        </button>
        <%= render partial: "rooms/games/change_game", locals: { room: @room, games: @games } %>
        <%= game_over_ad %>
      </div>
    <% end %>
  </div>

</div>
