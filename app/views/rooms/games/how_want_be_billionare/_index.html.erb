<div data-controller="millionaire"
     data-millionaire-status-value="loading"
     data-millionaire-room-code-value="<%= @room.code %>"
     data-millionaire-player-id-value="<%= session[:player_id] %>"
     class="relative min-h-screen bg-radial-at-b from-slate-950 via-blue-950 to-slate-950 text-white p-6 flex flex-col justify-between selection:bg-yellow-500/30">

  <!-- ================================================================= -->
  <!-- SECTION 1: LOADING PAGE -->
  <!-- ================================================================= -->
  <div data-millionaire-target="loading" class="flex-1 flex flex-col items-center justify-center min-h-[60vh] space-y-6">
    <div class="relative w-24 h-24">
      <div class="absolute inset-0 rounded-full border-4 border-blue-500/20"></div>
      <div class="absolute inset-0 rounded-full border-4 border-t-yellow-400 border-r-transparent animate-spin"></div>
    </div>
    <div class="text-center space-y-2">
      <h2 class="text-2xl font-black uppercase tracking-widest bg-gradient-to-r from-yellow-400 to-amber-200 bg-clip-text text-transparent">Preparing Questions</h2>
      <p class="text-sm text-blue-400 animate-pulse font-medium">Securing the bank vault...</p>
    </div>
  </div>

  <!-- ================================================================= -->
  <!-- SECTION 2: THE QUESTION (Host / TV view) -->
  <!-- ================================================================= -->
  <div data-millionaire-target="question" class="hidden flex-1 flex flex-col justify-center max-w-4xl mx-auto w-full space-y-12 my-auto">
    <div class="relative bg-gradient-to-b from-blue-900/80 to-slate-900/90 border-y-2 border-blue-500/50 p-8 text-center shadow-2xl backdrop-blur-md">
      <div class="absolute left-0 top-1/2 -translate-y-1/2 w-4 h-1 bg-blue-500"></div>
      <div class="absolute right-0 top-1/2 -translate-y-1/2 w-4 h-1 bg-blue-500"></div>
      <p data-millionaire-target="questionMeta" class="text-xs font-bold text-blue-400 uppercase tracking-widest mb-2"></p>
      <h2 data-millionaire-target="questionText" class="text-2xl md:text-3xl font-bold tracking-wide leading-relaxed">
        Loading question...
      </h2>
    </div>
  </div>

  <!-- ================================================================= -->
  <!-- SECTION 3: INTERACTIVE CONTROLS (Player input) -->
  <!-- ================================================================= -->
  <div data-millionaire-target="input" class="hidden flex-1 flex flex-col justify-between max-w-2xl mx-auto w-full pb-8 space-y-4">

    <%# Question text (duplicated for player view) %>
    <div class="relative bg-gradient-to-b from-blue-900/80 to-slate-900/90 border-y-2 border-blue-500/50 p-6 text-center shadow-2xl mt-4">
      <p data-millionaire-target="questionMeta" class="text-xs font-bold text-blue-400 uppercase tracking-widest mb-1"></p>
      <h2 data-millionaire-target="questionText" class="text-lg font-bold tracking-wide leading-relaxed">
        Loading question...
      </h2>
    </div>

    <div class="space-y-3">
      <p class="text-center text-xs font-black tracking-widest text-blue-400 uppercase">Lock in your final answer</p>

      <div class="grid grid-cols-1 gap-3 font-mono">
        <button data-action="click->millionaire#selectOption" data-option="0"
                class="w-full text-left bg-gradient-to-r from-blue-950 to-slate-900 border-2 border-blue-800 p-5 rounded-2xl
                       transition-all duration-200 hover:border-yellow-400 active:scale-[0.99] flex items-center justify-between group">
          <div>
            <span class="text-yellow-400 font-black mr-3">A:</span>
            <span data-millionaire-target="optionA" class="font-sans font-bold text-slate-200 group-hover:text-white"></span>
          </div>
          <div class="w-4 h-4 rounded-full border-2 border-blue-600 group-hover:border-yellow-400"></div>
        </button>

        <button data-action="click->millionaire#selectOption" data-option="1"
                class="w-full text-left bg-gradient-to-r from-blue-950 to-slate-900 border-2 border-blue-800 p-5 rounded-2xl
                       transition-all duration-200 hover:border-yellow-400 active:scale-[0.99] flex items-center justify-between group">
          <div>
            <span class="text-yellow-400 font-black mr-3">B:</span>
            <span data-millionaire-target="optionB" class="font-sans font-bold text-slate-200 group-hover:text-white"></span>
          </div>
          <div class="w-4 h-4 rounded-full border-2 border-blue-600 group-hover:border-yellow-400"></div>
        </button>

        <button data-action="click->millionaire#selectOption" data-option="2"
                class="w-full text-left bg-gradient-to-r from-blue-950 to-slate-900 border-2 border-blue-800 p-5 rounded-2xl
                       transition-all duration-200 hover:border-yellow-400 active:scale-[0.99] flex items-center justify-between group">
          <div>
            <span class="text-yellow-400 font-black mr-3">C:</span>
            <span data-millionaire-target="optionC" class="font-sans font-bold text-slate-200 group-hover:text-white"></span>
          </div>
          <div class="w-4 h-4 rounded-full border-2 border-blue-600 group-hover:border-yellow-400"></div>
        </button>

        <button data-action="click->millionaire#selectOption" data-option="3"
                class="w-full text-left bg-gradient-to-r from-blue-950 to-slate-900 border-2 border-blue-800 p-5 rounded-2xl
                       transition-all duration-200 hover:border-yellow-400 active:scale-[0.99] flex items-center justify-between group">
          <div>
            <span class="text-yellow-400 font-black mr-3">D:</span>
            <span data-millionaire-target="optionD" class="font-sans font-bold text-slate-200 group-hover:text-white"></span>
          </div>
          <div class="w-4 h-4 rounded-full border-2 border-blue-600 group-hover:border-yellow-400"></div>
        </button>
      </div>

      <%# Shown after the player locks in an answer %>
      <p data-millionaire-target="lockedMessage"
         class="hidden text-center text-green-400 font-black tracking-widest text-sm uppercase mt-2">
        Answer locked in ✓ — waiting for round to end...
      </p>
    </div>
  </div>

  <!-- ================================================================= -->
  <!-- SECTION 4: LEADERBOARD -->
  <!-- ================================================================= -->
  <div data-millionaire-target="leaderboard" class="hidden flex-1 flex flex-col justify-center max-w-xl mx-auto w-full my-auto space-y-8">
    <div class="text-center">
      <h2 class="text-4xl font-black bg-gradient-to-b from-yellow-300 via-amber-400 to-amber-600 bg-clip-text text-transparent italic tracking-wider uppercase">Leaderboard</h2>
      <p class="text-xs tracking-widest text-blue-400 font-bold uppercase mt-1">Final Standings</p>
    </div>

    <div data-millionaire-target="leaderboardList" class="space-y-3"></div>

    <% if session[:player_id].blank? %>
      <%= render partial: "rooms/games/change_game", locals: { room: @room, games: @games } %>
    <% end %>
  </div>

</div>
