<%# Question packs: the import's files that have questions in the room's language. %>
<% packs = HowWantBeBillionare::Question.where(HowWantBeBillionare::Question.match_for(@room.locale)).distinct(:pack) %>
<% packs = GameServices::HowWantBeBillionare::PACKS & packs %>
<% if packs.any? %>
  <div class="space-y-6 bg-slate-900/50 p-6 rounded-2xl border border-slate-700 mb-2">
    <label class="block text-xs font-bold text-slate-400 mb-3 tracking-widest"><%= t(".topics") %></label>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      <% [ [ "", t(".all_topics") ], *packs.map { |pack| [ pack, t(".packs.#{pack}") ] } ].each do |value, label| %>
        <label class="relative cursor-pointer">
          <input type="radio" name="room[game_state][pack]" value="<%= value %>"
                 class="peer hidden" <%= 'checked' if @room.game_state['pack'].to_s == value %>>
          <div class="h-full flex items-center justify-center text-center py-3 px-2 bg-slate-800 border-2 border-slate-700 rounded-xl text-white text-sm font-bold
                      peer-checked:border-purple-500 peer-checked:bg-purple-500/10 transition-all">
            <%= label %>
          </div>
        </label>
      <% end %>
    </div>
  </div>
<% end %>

<div class="space-y-6 bg-slate-900/50 p-6 rounded-2xl border border-slate-700">
  <label class="block text-xs font-bold text-slate-400 mb-3 tracking-widest"><%= t(".rounds") %></label>
  <div class="grid grid-cols-3 gap-3">
    <% [5, 10, 20, 30].each do |num| %>
      <label class="relative cursor-pointer">
        <input type="radio" name="room[game_state][total_rounds]" value="<%= num %>" 
                class="peer hidden" <%= 'checked' if (@room.game_state['total_rounds'] || GameServices::HowWantBeBillionare::DEFAULT_ROUNDS).to_i == num %>>
        <div class="text-center py-3 bg-slate-800 border-2 border-slate-700 rounded-xl text-white font-bold 
                    peer-checked:border-purple-500 peer-checked:bg-purple-500/10 transition-all">
          <%= t(".rounds_option", count: num) %>
        </div>
      </label>
    <% end %>
  </div>
</div>

<div class="space-y-6 bg-slate-900/50 p-6 rounded-2xl border border-slate-700 mt-2">
  <label class="block text-xs font-bold text-slate-400 mb-3 tracking-widest"><%= t(".time") %></label>
  <div class="grid grid-cols-3 gap-3">
    <% [5, 10, 20, 30].each do |num| %>
      <label class="relative cursor-pointer">
        <input type="radio" name="room[game_state][time_per_round]" value="<%= num %>" 
                class="peer hidden" <%= 'checked' if (@room.game_state['time_per_round'] || GameServices::HowWantBeBillionare::DEFAULT_SECONDS).to_i == num %>>
        <div class="text-center py-3 bg-slate-800 border-2 border-slate-700 rounded-xl text-white font-bold 
                    peer-checked:border-purple-500 peer-checked:bg-purple-500/10 transition-all">
          <%= num %>
        </div>
      </label>
    <% end %>
  </div>
</div>

<div class="space-y-6 bg-slate-900/50 p-6 rounded-2xl border border-slate-700 mt-2">
  <label class="block text-xs font-bold text-slate-400 mb-3 tracking-widest"><%= t(".advance") %></label>
  <div class="grid grid-cols-2 gap-3">
    <% [["auto", t(".auto"), t(".auto_desc")], ["manual", t(".manual"), t(".manual_desc")]].each do |value, label, desc| %>
      <label class="relative cursor-pointer">
        <input type="radio" name="room[game_state][advance]" value="<%= value %>"
               class="peer hidden" <%= 'checked' if (@room.game_state['advance'] || 'auto') == value %>>
        <div class="text-center py-3 px-2 bg-slate-800 border-2 border-slate-700 rounded-xl transition-all
                    peer-checked:border-purple-500 peer-checked:bg-purple-500/10">
          <p class="text-white font-bold"><%= label %></p>
          <p class="text-slate-500 text-xs mt-1"><%= desc %></p>
        </div>
      </label>
    <% end %>
  </div>
</div>
