<div class="space-y-6 bg-slate-900/50 p-6 rounded-2xl border border-slate-700">
  <label class="block text-xs font-bold text-slate-400 mb-3 tracking-widest"><%= t(".rounds") %></label>
  <div class="grid grid-cols-3 gap-3">
    <% [5, 10, 20, 30].each do |num| %>
      <label class="relative cursor-pointer">
        <input type="radio" name="room[game_state][total_rounds]" value="<%= num %>" 
                class="peer hidden" <%= 'checked' if @room.game_state['total_rounds'].to_i == num %>>
        <div class="text-center py-3 bg-slate-800 border-2 border-slate-700 rounded-xl text-white font-bold 
                    peer-checked:border-purple-500 peer-checked:bg-purple-500/10 transition-all">
          <%= t(".rounds_option", count: num) %>
        </div>
      </label>
    <% end %>
  </div>
</div>

<div class="space-y-6 bg-slate-900/50 p-6 rounded-2xl border border-slate-700 mt-2">
  <label class="block text-xs font-bold text-slate-400 mb-3 tracking-widest"><%= t(".time") %></label>
  <div class="grid grid-cols-3 gap-3">
    <% [5, 10, 20, 30].each do |num| %>
      <label class="relative cursor-pointer">
        <input type="radio" name="room[game_state][time_per_round]" value="<%= num %>" 
                class="peer hidden" <%= 'checked' if @room.game_state['time_per_round'].to_i == num %>>
        <div class="text-center py-3 bg-slate-800 border-2 border-slate-700 rounded-xl text-white font-bold 
                    peer-checked:border-purple-500 peer-checked:bg-purple-500/10 transition-all">
          <%= num %>
        </div>
      </label>
    <% end %>
  </div>
</div>

<div class="space-y-6 bg-slate-900/50 p-6 rounded-2xl border border-slate-700 mt-2">
  <label class="block text-xs font-bold text-slate-400 mb-3 tracking-widest"><%= t(".instructions") %></label>
  <%= game_image_tag @room.game, alt: t(".image_alt", game: @room.game.name), sizes: "(min-width: 672px) 560px, 90vw", class: "w-full h-auto" %>
</div>
