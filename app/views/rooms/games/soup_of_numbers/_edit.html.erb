<% pickers = [
     ["GRID SIZE",       "grid_size",    "10", [["8", "8×8"], ["10", "10×10"], ["12", "12×12"], ["15", "15×15"]]],
     ["MAX NUMBER SIZE", "max_digits",   "4",  [["2", "2 digits"], ["3", "3 digits"], ["4", "4 digits"], ["5", "5 digits"]]],
     ["ROUNDS",          "total_rounds", "10", [["5", "5 rounds"], ["10", "10 rounds"], ["15", "15 rounds"]]],
     ["TIME PER ROUND",  "round_time",   "60", [["30", "30s"], ["60", "60s"], ["90", "90s"]]]
   ] %>

<% pickers.each_with_index do |(title, key, default, options), i| %>
  <div class="space-y-4 bg-slate-900/50 p-6 rounded-2xl border border-slate-700 <%= 'mt-2' if i > 0 %>">
    <label class="block text-xs font-bold text-slate-400 mb-3 tracking-widest"><%= title %></label>
    <div class="grid <%= options.length == 4 ? "grid-cols-4" : "grid-cols-3" %> gap-3">
      <% options.each do |value, label| %>
        <label class="relative cursor-pointer">
          <input type="radio"
                 name="room[game_state][<%= key %>]"
                 value="<%= value %>"
                 class="peer hidden"
                 <%= 'checked' if (@room.game_state[key]&.to_s || default) == value %>>
          <div class="text-center py-3 px-2 bg-slate-800 border-2 border-slate-700 rounded-xl text-white font-bold
                      peer-checked:border-emerald-500 peer-checked:bg-emerald-500/10 transition-all">
            <%= label %>
          </div>
        </label>
      <% end %>
    </div>
    <% if key == "max_digits" %>
      <p class="text-slate-500 text-xs">Numbers mix lengths from 2 digits up to this size.</p>
    <% end %>
  </div>
<% end %>
