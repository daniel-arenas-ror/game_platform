<%# Rendered inside the host game-over overlay. A QR so new players can join before the next game,
    a link back to this game's settings, and a link to the games page to pick a new game for the
    same room. "Change settings" goes through change_game with the same game, so phones return to
    the lobby; open_settings stops this screen from following them there. The QR sits in the corner (the Players button has the other one), big screens only:
    the overlays are centred and don't scroll, so it can't go in with a full leaderboard. Below the
    links, 3 other games to try (compact, so they fit under any leaderboard). %>
<% link_css = "text-slate-400 hover:text-white text-sm underline underline-offset-4 transition-colors cursor-pointer" %>
<div class="mt-4">
  <% if @svg %>
    <div data-game-over-qr class="fixed bottom-3 right-3 z-[60] hidden w-52 flex-col items-center gap-2 rounded-2xl border border-slate-700 bg-slate-800 p-3 text-center lg:flex">
      <div class="rounded-xl bg-white p-1.5 [&>svg]:block [&>svg]:size-32"><%= @svg.html_safe %></div>
      <p class="text-sm font-bold text-white text-balance"><%= t("rooms.games.change_game.scan") %></p>
      <p class="font-mono text-xs font-bold text-purple-300 break-all"><%= @join_url.sub(%r{\Ahttps?://}, "") %></p>
    </div>
  <% end %>
  <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
    <%= button_to t("rooms.games.change_game.settings"), change_game_room_path(room.code),
          params: { game_id: room.game_id }, method: :post, class: link_css,
          form: { data: { controller: "open-settings", action: "submit->open-settings#stopListening" } } %>
    <%= link_to t("rooms.games.change_game.link"), games_path(room: room.code), class: link_css %>
  </div>

  <%# "Maybe you'd like to play these too": 3 other games that suit this many players, picked from the
      top of the catalog so they change from game to game. One tap switches the room, like Change Game. %>
  <% players     = room.players.count %>
  <% fits        = ->(g) { (g.min_players.nil? || players >= g.min_players) && (g.max_players.nil? || players <= g.max_players) } %>
  <% suggestions = (local_assigns[:games] || Game.catalog).reject { |g| g.id == room.game_id }.select(&fits).first(6).sample(3) %>
  <% if suggestions.any? %>
    <div class="mt-5">
      <p class="text-xs font-bold uppercase tracking-widest text-slate-400"><%= t("rooms.games.change_game.suggest") %></p>
      <div class="mt-2 flex flex-wrap items-center justify-center gap-2">
        <% suggestions.each do |game| %>
          <%= button_to change_game_room_path(room.code), params: { game_id: game.id }, method: :post,
                class: "flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-800/90 py-1 pl-1 pr-3 text-sm font-bold text-white hover:border-slate-500 transition-colors cursor-pointer",
                form: suggested_game_analytics(game, room) do %>
            <%= game_art_tag(game, sizes: "32px", card: true, class: "size-8 shrink-0 rounded-lg object-cover") %>
            <span class="max-w-28 truncate"><%= game.name %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
