<% is_host = session[:player_id].blank? %>

<% if is_host %>
  <%# ================================================================= %>
  <%# HOST VIEW — big screen / TV                                        %>
  <%# ================================================================= %>
  <div data-controller="matching-pairs-host"
       data-matching-pairs-host-room-code-value="<%= @room.code %>"
       class="relative flex flex-col min-h-screen bg-slate-950 text-white overflow-hidden">

    <%# Header %>
    <div class="flex items-center justify-between px-8 pt-6">
      <h1 class="text-2xl font-black tracking-widest uppercase text-rose-400">🃏 <%= @room.game.name %></h1>
      <p class="text-slate-500 text-xs font-mono tracking-widest">
        <%= t("rooms.games.shared.room") %> <span class="text-white font-bold"><%= @room.code %></span>
        · <span data-matching-pairs-host-target="roundLabel"></span>
      </p>
    </div>

    <div class="flex-1 flex items-center justify-center gap-10 px-8 py-6">
      <%# The board %>
      <div data-matching-pairs-host-target="board"
           class="grid gap-2 p-3 bg-slate-900 rounded-3xl border-2 border-slate-700 shadow-2xl"
           style="width: min(56vw, 76vh);"></div>

      <%# Sidebar %>
      <div class="w-80 shrink-0 space-y-5">
        <%# Phase + countdown %>
        <div class="bg-slate-800 rounded-3xl border-2 border-rose-500/40 p-6 text-center">
          <p data-matching-pairs-host-target="phaseTitle"
             class="text-white font-black text-2xl leading-tight"><%= t(".get_ready") %></p>
          <p data-matching-pairs-host-target="phaseHint"
             class="text-slate-400 text-sm mt-2"></p>
          <p data-matching-pairs-host-target="countdown"
             class="font-mono font-black text-6xl mt-4 tabular-nums"></p>
        </div>

        <%# Leaderboard %>
        <div class="bg-slate-800 rounded-3xl border border-slate-700 p-5">
          <div class="flex items-center justify-between mb-3">
            <p class="text-slate-400 text-xs uppercase tracking-widest font-mono"><%= t(".scores") %></p>
            <p data-matching-pairs-host-target="pairsLabel" class="text-slate-500 text-xs font-mono"></p>
          </div>
          <div data-matching-pairs-host-target="scoreboard" class="space-y-3"></div>
        </div>
      </div>
    </div>

    <%# Toasts ("Ana cleared the board!") %>
    <div data-matching-pairs-host-target="toasts"
         class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2 pointer-events-none"></div>

    <%# Game over overlay %>
    <div data-matching-pairs-host-target="phaseGameOver"
         class="hidden absolute inset-0 z-30 flex flex-col items-center justify-center bg-slate-950/95">
      <p class="text-6xl mb-4">🏆</p>
      <h2 class="text-5xl font-black text-rose-400 tracking-widest mb-8"><%= t("rooms.games.shared.game_over") %></h2>
      <div data-matching-pairs-host-target="finalLeaderboard"
           class="space-y-3 w-full max-w-sm mb-10"></div>
      <button data-matching-pairs-host-target="playAgain"
              class="bg-rose-500 hover:bg-rose-400 text-white font-black px-10 py-3
                     rounded-xl uppercase tracking-widest text-lg transition-colors cursor-pointer">
        <%= t("rooms.games.shared.play_again") %>
      </button>
      <%= render partial: "rooms/games/change_game", locals: { room: @room, games: @games } %>
      <%= game_over_ad %>
    </div>
  </div>

<% else %>
  <%# ================================================================= %>
  <%# PLAYER VIEW — mobile phone                                         %>
  <%# ================================================================= %>
  <% current_player %>
  <div data-controller="matching-pairs-player"
       data-matching-pairs-player-room-code-value="<%= @room.code %>"
       data-matching-pairs-player-player-id-value="<%= session[:player_id] %>"
       class="flex flex-col min-h-screen bg-slate-950 text-white select-none">

    <%# Header %>
    <div class="flex items-center justify-between px-4 pt-5 pb-2">
      <div>
        <p class="font-black text-lg tracking-wide leading-tight"><%= session[:nickname] %></p>
        <p data-matching-pairs-player-target="pairs" class="text-slate-500 text-xs font-mono"></p>
      </div>
      <div class="text-right">
        <p class="text-[10px] text-slate-600 uppercase tracking-widest"><%= t("rooms.games.shared.points") %></p>
        <p data-matching-pairs-player-target="score"
           class="font-mono font-black text-3xl text-rose-400 leading-none">0</p>
      </div>
    </div>

    <%# Status line %>
    <div class="flex items-center justify-between px-4 pb-3">
      <p data-matching-pairs-player-target="status"
         class="text-slate-400 text-xs uppercase tracking-widest font-mono"><%= t(".get_ready") %></p>
      <p data-matching-pairs-player-target="countdown"
         class="font-mono font-black text-2xl tabular-nums"></p>
    </div>

    <%# The board, with a cover while everyone looks at the TV %>
    <div class="relative px-2">
      <div data-matching-pairs-player-target="board"
           data-action="pointerdown->matching-pairs-player#tap"
           class="grid gap-1.5 p-1.5 bg-slate-900 rounded-2xl border border-slate-700 mx-auto touch-manipulation"
           style="width: min(100%, 68vh);"></div>

      <div data-matching-pairs-player-target="cover"
           class="absolute inset-0 mx-2 flex flex-col items-center justify-center rounded-2xl bg-slate-950/90 text-center px-6">
        <p class="text-6xl mb-3">📺</p>
        <p data-matching-pairs-player-target="coverTitle" class="font-black text-2xl"><%= t(".look_tv") %></p>
        <p data-matching-pairs-player-target="coverHint" class="text-slate-400 text-sm mt-2">
          <%= t(".remember") %>
        </p>
      </div>
    </div>

    <%# Feedback %>
    <p data-matching-pairs-player-target="feedback"
       class="min-h-8 text-center font-black text-xl mt-4 px-4"></p>

    <%# Game over %>
    <div data-matching-pairs-player-target="phaseGameOver"
         class="hidden fixed inset-0 z-30 flex flex-col items-center justify-center bg-slate-950/95 text-center px-6">
      <p data-matching-pairs-player-target="gameOverIcon" class="text-5xl mb-3">🏆</p>
      <p data-matching-pairs-player-target="gameOverTitle"
         class="font-black text-3xl tracking-wide mb-4"></p>
      <p data-matching-pairs-player-target="finalScore"
         class="text-rose-400 font-mono font-black text-5xl"></p>
      <p class="text-slate-500 text-xs mt-1 font-mono"><%= t("rooms.games.shared.total_points") %></p>
      <p class="text-slate-600 text-xs mt-8 font-mono"><%= t("rooms.games.shared.waiting_restart") %></p>
    </div>

    <p class="text-center text-slate-800 text-[10px] font-mono mt-auto pb-4"><%= t("rooms.games.shared.room") %> <%= @room.code %></p>
  </div>
<% end %>
