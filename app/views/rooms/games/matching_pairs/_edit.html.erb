<% pickers = [
     [t(".board"),  "grid",         "4x5",    [["4x4", "4×4"], ["4x5", "4×5"], ["5x6", "5×6"], ["6x6", "6×6"]]],
     [t(".cards"),  "category",     "random", [["animals", "🐶 #{t(".animals")}"], ["objects", "🎈 #{t(".objects")}"], ["flags", "🚩 #{t(".flags")}"],
                                               ["numbers", "🔢 #{t(".numbers")}"], ["random", "🎲 #{t(".random")}"]]],
     [t(".time"),   "round_time",   "120",    [["60", "60s"], ["90", "90s"], ["120", "120s"], ["180", "180s"]]],
     [t(".rounds"), "total_rounds", "1",      [1, 2, 3, 5].map { |n| [n.to_s, t(".rounds_option", count: n)] }]
   ] %>

<% pickers.each_with_index do |(title, key, default, options), i| %>
  <div class="space-y-4 bg-slate-900/50 p-6 rounded-2xl border border-slate-700 <%= 'mt-2' if i > 0 %>">
    <label class="block text-xs font-bold text-slate-400 mb-3 tracking-widest"><%= title %></label>
    <div class="grid <%= options.length == 5 ? "grid-cols-2 sm:grid-cols-5" : "grid-cols-4" %> gap-3">
      <% options.each do |value, label| %>
        <label class="relative cursor-pointer">
          <input type="radio"
                 name="room[game_state][<%= key %>]"
                 value="<%= value %>"
                 class="peer hidden"
                 <%= 'checked' if (@room.game_state[key]&.to_s || default) == value %>>
          <div class="text-center py-3 px-2 bg-slate-800 border-2 border-slate-700 rounded-xl text-white font-bold
                      peer-checked:border-rose-500 peer-checked:bg-rose-500/10 transition-all">
            <% if key == "category" %>
              <% icon, text = label.split(" ", 2) %>
              <span class="block text-2xl leading-none mb-1"><%= icon %></span><%= text %>
            <% else %>
              <%= label %>
            <% end %>
          </div>
        </label>
      <% end %>
    </div>
    <% if key == "grid" %>
      <p class="text-slate-500 text-xs"><%= t(".board_note") %></p>
    <% end %>
  </div>
<% end %>
