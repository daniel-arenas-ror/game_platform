<% is_host = session[:player_id].blank? %>

<% if is_host %>
  <%# ================================================================= %>
  <%# HOST VIEW                                                          %>
  <%# ================================================================= %>
  <div data-controller="submarine-combat-host"
       data-submarine-combat-host-room-code-value="<%= @room.code %>"
       data-submarine-combat-host-grid-size-value="<%= @room.game_state['grid_size'] || 8 %>"
       data-submarine-combat-host-sub-count-value="<%= @room.game_state['sub_count'] || 3 %>"
       class="min-h-screen bg-slate-950 text-white">

    <%# ── Phase: Waiting for all players to place their fleet ── %>
    <div data-submarine-combat-host-target="phaseWaiting">
      <div class="flex flex-col items-center justify-center min-h-screen p-8">
        <p class="text-cyan-400 font-mono text-xs uppercase tracking-widest mb-2">Submarine Combat</p>
        <h1 class="text-3xl font-black text-white mb-2">Waiting for Players</h1>
        <p class="text-slate-400 text-sm mb-10">Players are placing their submarines...</p>

        <div data-submarine-combat-host-target="playerList"
             class="flex flex-wrap gap-3 justify-center mb-10 min-h-[48px]">
        </div>

        <button data-action="click->submarine-combat-host#startBattle"
                data-submarine-combat-host-target="startBtn"
                disabled
                class="px-10 py-4 bg-cyan-600 text-white font-black text-lg rounded-2xl
                       disabled:opacity-30 disabled:cursor-not-allowed
                       hover:bg-cyan-500 transition-colors">
          Start Battle
        </button>
      </div>
    </div>

    <%# ── Phase: Battle ── %>
    <div data-submarine-combat-host-target="phaseBattle" class="hidden">
      <div class="flex flex-col items-center p-6 pt-8">

        <%# Round header + timer %>
        <div class="flex items-center gap-6 mb-6">
          <p data-submarine-combat-host-target="roundLabel"
             class="text-slate-300 font-mono text-sm uppercase tracking-widest">
            Round —
          </p>
          <div data-submarine-combat-host-target="timerDisplay"
               class="w-14 h-14 rounded-full border-4 border-cyan-500 flex items-center justify-center
                      text-cyan-400 font-black text-xl tabular-nums">
            —
          </div>
        </div>

        <%# Submissions tracker — who has fired this round %>
        <div data-submarine-combat-host-target="submissionsList"
             class="flex flex-wrap gap-2 justify-center mb-4 min-h-[32px]">
        </div>

        <%# Per-player boards — one grid per player showing hit/miss/untouched %>
        <div data-submarine-combat-host-target="playerBoards"
             class="grid gap-6 w-full max-w-4xl mb-4">
        </div>

        <%# Legend %>
        <div class="flex gap-4 text-xs font-mono text-slate-500 mt-1">
          <span class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-sm bg-red-600"></span> Hit
          </span>
          <span class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-sm bg-slate-600"></span> Miss
          </span>
          <span class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-sm bg-slate-900 border border-slate-700"></span> Not fired
          </span>
        </div>

      </div>
    </div>

    <%# ── Phase: Game Over ── %>
    <div data-submarine-combat-host-target="phaseGameOver" class="hidden">
      <div class="flex flex-col items-center justify-center min-h-screen p-8 text-center">
        <p class="text-yellow-400 font-mono text-xs uppercase tracking-widest mb-2">Game Over</p>
        <h1 data-submarine-combat-host-target="gameOverTitle"
            class="text-4xl font-black text-white mb-8">
        </h1>

        <div data-submarine-combat-host-target="finalScores"
             class="w-full max-w-xs mb-10 space-y-2">
        </div>

        <button data-action="click->submarine-combat-host#restartGame"
                class="px-8 py-4 bg-cyan-600 text-white font-black text-base rounded-2xl
                       hover:bg-cyan-500 transition-colors">
          Play Again
        </button>
        <%= render partial: "rooms/games/change_game", locals: { room: @room, games: @games } %>
      </div>
    </div>

    <%# Toast container — floating notifications above all phases %>
    <div data-submarine-combat-host-target="toastContainer"
         class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 flex flex-col-reverse gap-2 items-center pointer-events-none">
    </div>

  </div>

<% else %>
  <%# ================================================================= %>
  <%# PLAYER VIEW                                                        %>
  <%# ================================================================= %>
  <div data-controller="submarine-combat-player"
       data-submarine-combat-player-room-code-value="<%= @room.code %>"
       data-submarine-combat-player-player-id-value="<%= session[:player_id] %>"
       data-submarine-combat-player-grid-size-value="<%= @room.game_state['grid_size'] || 8 %>"
       data-submarine-combat-player-sub-count-value="<%= @room.game_state['sub_count'] || 3 %>"
       class="min-h-screen bg-slate-950 text-white">

    <%# ── Phase: Placement ── %>
    <div data-submarine-combat-player-target="phasePlacement">
      <div class="flex flex-col items-center px-4 pt-8 pb-6">

        <p class="text-cyan-400 font-mono text-xs uppercase tracking-widest mb-1">Submarine Combat</p>
        <h1 class="text-2xl font-black text-white mb-1">Place Your Fleet</h1>
        <p class="text-slate-500 text-xs mb-5">Tap a ship to select, then tap a cell to move it</p>

        <div data-submarine-combat-player-target="shipInfo" class="mb-4 h-6 text-center"></div>

        <div data-submarine-combat-player-target="grid"
             class="grid gap-0.5 w-full max-w-xs mb-6">
        </div>

        <div class="flex gap-3">
          <button data-action="click->submarine-combat-player#rotateShip"
                  data-submarine-combat-player-target="rotateBtn"
                  disabled
                  class="px-5 py-3 bg-slate-700 text-white font-bold rounded-xl text-sm
                         disabled:opacity-40 disabled:cursor-not-allowed hover:bg-slate-600 transition-colors">
            Rotate
          </button>
          <button data-action="click->submarine-combat-player#shuffleAll"
                  class="px-5 py-3 bg-slate-700 text-white font-bold rounded-xl text-sm
                         hover:bg-slate-600 transition-colors">
            Shuffle
          </button>
          <button data-action="click->submarine-combat-player#confirmPlacement"
                  data-submarine-combat-player-target="confirmBtn"
                  class="px-5 py-3 bg-cyan-600 text-white font-bold rounded-xl text-sm
                         disabled:opacity-40 disabled:cursor-not-allowed hover:bg-cyan-500 transition-colors">
            Confirm
          </button>
        </div>

      </div>
    </div>

    <%# ── Phase: Waiting (confirmed, waiting for battle start) ── %>
    <div data-submarine-combat-player-target="phaseWaiting" class="hidden">
      <div class="flex flex-col items-center justify-center min-h-screen p-8 text-center">
        <p class="text-cyan-400 font-mono text-xs uppercase tracking-widest mb-2">Fleet Locked In</p>
        <h1 class="text-2xl font-black text-white mb-2">Ready for Battle!</h1>
        <p class="text-slate-400 text-sm mb-8">Waiting for all players to confirm their fleet...</p>

        <div data-submarine-combat-player-target="waitingList"
             class="flex flex-wrap gap-3 justify-center">
        </div>
      </div>
    </div>

    <%# ── Phase: Battle ── %>
    <div data-submarine-combat-player-target="phaseBattle" class="hidden">
      <div class="flex flex-col items-center px-4 pt-6 pb-8">

        <%# Round header + timer %>
        <div class="flex items-center justify-between w-full max-w-xs mb-4">
          <p data-submarine-combat-player-target="roundLabel"
             class="text-slate-400 font-mono text-xs uppercase tracking-widest">
            Round —
          </p>
          <div data-submarine-combat-player-target="timerDisplay"
               class="w-12 h-12 rounded-full border-4 border-cyan-500 flex items-center justify-center
                      text-cyan-400 font-black text-lg tabular-nums">
            —
          </div>
        </div>

        <%# Submissions tracker (who has fired) %>
        <div data-submarine-combat-player-target="submissionsList"
             class="flex flex-wrap gap-1.5 justify-center mb-4 min-h-[28px]">
        </div>

        <%# Shot status / instruction %>
        <p data-submarine-combat-player-target="shotStatus"
           class="text-slate-400 text-xs mb-3 text-center">
          Tap a cell to pick your target
        </p>

        <%# Attack grid %>
        <div data-submarine-combat-player-target="attackGrid"
             class="grid gap-0.5 w-full max-w-xs mb-4">
        </div>

        <%# Fire button %>
        <button data-action="click->submarine-combat-player#submitShot"
                data-submarine-combat-player-target="fireBtn"
                disabled
                class="w-full max-w-xs py-4 bg-red-600 text-white font-black text-base rounded-2xl
                       disabled:opacity-30 disabled:cursor-not-allowed hover:bg-red-500 transition-colors mb-8">
          Fire!
        </button>

        <%# Defense grid %>
        <p class="text-slate-600 font-mono text-xs uppercase tracking-widest mb-3">Your Fleet</p>

        <div data-submarine-combat-player-target="defenseGrid"
             class="grid gap-0.5 w-full max-w-[180px]">
        </div>

      </div>
    </div>

    <%# ── Phase: Spectator (eliminated) — shows live grids ── %>
    <div data-submarine-combat-player-target="phaseSpectator" class="hidden">
      <div class="flex flex-col items-center px-4 pt-8 pb-8">
        <p class="text-red-400 font-mono text-xs uppercase tracking-widest mb-1">Eliminated</p>
        <h1 class="text-xl font-black text-white mb-1">Your Fleet Was Destroyed</h1>
        <p data-submarine-combat-player-target="spectatorRoundLabel"
           class="text-slate-500 font-mono text-xs mb-6">Watching the battle...</p>

        <div data-submarine-combat-player-target="spectatorGrids"
             class="grid grid-cols-2 gap-4 w-full max-w-2xl">
          <%# Populated by JS on each round_result %>
        </div>
      </div>
    </div>

    <%# ── Phase: Game Over ── %>
    <div data-submarine-combat-player-target="phaseGameOver" class="hidden">
      <div class="flex flex-col items-center justify-center min-h-screen p-8 text-center">
        <p class="text-yellow-400 font-mono text-xs uppercase tracking-widest mb-2">Game Over</p>
        <h1 data-submarine-combat-player-target="gameOverTitle"
            class="text-3xl font-black mb-8">
        </h1>

        <div data-submarine-combat-player-target="finalScores"
             class="w-full max-w-xs space-y-2">
        </div>
      </div>
    </div>

    <%# Elimination overlay — animated full-screen flash, z-index above everything %>
    <div data-submarine-combat-player-target="eliminationOverlay"
         class="hidden fixed inset-0 z-50 bg-red-950/95 flex items-center justify-center">
      <div class="text-center">
        <p class="text-red-400 font-mono text-xs uppercase tracking-widest mb-3">Eliminated</p>
        <h1 class="text-5xl font-black text-white">Your Fleet<br>Was Destroyed</h1>
      </div>
    </div>

    <%# Toast container — floating event notifications %>
    <div data-submarine-combat-player-target="toastContainer"
         class="fixed bottom-8 left-1/2 -translate-x-1/2 z-40 flex flex-col-reverse gap-2 items-center pointer-events-none">
    </div>

  </div>
<% end %>
