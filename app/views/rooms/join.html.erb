<%# A player's phone after scanning the QR: pick a nickname and enter the lobby.
    nickname_preview_controller shows their blobatar (the avatar they keep in every game) as they type. %>
<div class="bg-slate-900 min-h-screen flex items-center justify-center px-4 py-8">
  <div class="max-w-sm w-full">
    <div class="relative overflow-hidden rounded-[2rem] border border-slate-700 bg-slate-800 shadow-2xl shadow-black/40">
      <%= game_art_tag @game, alt: "", card: true, sizes: "384px", class: "w-full aspect-[16/9] object-cover object-top" %>

      <div class="px-6 pb-8 pt-6 text-center">
        <h1 class="text-display text-3xl text-white text-balance"><%= t(".title", game: @game.name) %></h1>
        <p class="mt-3 text-slate-400">
          <%= t(".room_code") %>
          <span class="ml-1 inline-flex gap-1 align-middle" aria-label="<%= @room.code %>">
            <% @room.code.each_char do |ch| %>
              <span aria-hidden="true" class="grid place-items-center size-7 rounded-lg border-2 border-purple-400 bg-slate-950 font-mono font-black text-sm text-white"><%= ch %></span>
            <% end %>
          </span>
        </p>

        <% if flash[:alert].present? %>
          <p role="alert" class="mt-6 rounded-2xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm font-semibold text-red-200"><%= flash[:alert] %></p>
        <% end %>

        <%= form_with url: submit_join_path(@room.code), method: :post, class: "mt-8 space-y-6",
              data: { controller: "nickname-preview" } do |f| %>
          <%# The disc you'll have in the lobby, filled in as you type %>
          <div class="flex flex-col items-center gap-2" aria-hidden="true">
            <span data-nickname-preview-target="disc"
                  class="grid place-items-center size-20 overflow-hidden rounded-full border-4 border-dashed border-slate-600 bg-slate-900 font-display text-4xl font-extrabold text-white transition-colors duration-300 [&>svg]:size-full">?</span>
            <span class="text-xs font-semibold text-slate-500"><%= t(".preview_label") %></span>
          </div>

          <div>
            <%= f.label :nickname, t(".nickname"), class: "block eyebrow text-slate-400 mb-2" %>
            <%= f.text_field :nickname,
                placeholder: t(".nickname_placeholder"),
                maxlength: 12,
                required: true,
                autofocus: true,
                autocomplete: "nickname",
                enterkeyhint: "go",
                data: { nickname_preview_target: "input", action: "input->nickname-preview#update" },
                class: "w-full h-16 bg-slate-950 border-[3px] border-slate-700 rounded-2xl px-4 text-white text-center font-display font-extrabold text-2xl placeholder:text-slate-500 placeholder:font-semibold placeholder:text-lg focus:border-purple-400 focus:outline-none transition-colors" %>
          </div>

          <%= f.submit t(".submit"), class: "btn btn-lg w-full" %>
        <% end %>

        <p class="mt-6 inline-flex items-center gap-2 text-sm text-slate-400">
          <%= t(".wait") %><%= render "shared/bouncing_dots" %>
        </p>
      </div>
    </div>
  </div>
</div>
