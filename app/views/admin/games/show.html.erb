<% content_for :title, "Games" %>
<% shown = @games.count { _1.listed != false } %>

<div>
  <h1 class="text-3xl font-extrabold tracking-tight text-white">Games</h1>
  <p class="mt-1 text-sm text-slate-400">
    <%= shown %> of <%= @games.size %> shown on the site · in the order the catalog shows them
  </p>
</div>

<% christmas = SiteSetting.christmas? %>
<section aria-labelledby="christmas-mode" class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-800 bg-slate-900 px-5 py-4">
  <div>
    <h2 id="christmas-mode" class="font-bold text-white">🎄 Christmas mode <span class="ml-1 text-sm font-semibold <%= christmas ? "text-green-300" : "text-slate-500" %>"><%= christmas ? "On" : "Off" %></span></h2>
    <p class="mt-1 text-sm text-slate-400">Santa hat on the logo and the tab icon, snow and lights on the public pages. Never during a game.</p>
  </div>
  <%= button_to christmas ? "Turn off" : "Turn on", admin_settings_path, method: :patch, params: { christmas: christmas ? "0" : "1" },
        class: "rounded-lg px-4 py-2 font-semibold cursor-pointer #{christmas ? "border border-slate-700 text-slate-300 hover:text-white" : "bg-green-600 text-white hover:bg-green-500"}" %>
</section>

<%= form_with url: admin_games_path, method: :patch, class: "mt-6" do %>
  <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900">
    <table class="w-full min-w-[40rem] text-sm tabular-nums">
      <thead class="text-left text-xs uppercase tracking-widest text-slate-500">
        <tr class="border-b border-slate-800">
          <th class="px-5 py-3 font-black">Position</th>
          <th class="py-3 font-black">Game</th>
          <th class="py-3 text-right font-black">Rooms</th>
          <th class="py-3 pl-6 font-black">Shown</th>
          <th class="py-3 pr-5 font-black"><span class="sr-only">Page</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800">
        <% @games.each do |game| %>
          <% field = "games[#{game.id}]" %>
          <tr class="hover:bg-slate-800/50 <%= "opacity-60" if game.listed == false %>">
            <td class="px-5 py-3">
              <%= number_field_tag "#{field}[position]", game.position, min: 1, max: Admin::GamesController::MAX_POSITION,
                    placeholder: "—", aria: { label: "Position of #{game.name}" },
                    class: "w-20 rounded-lg border border-slate-700 bg-slate-950 px-3 py-1.5 text-white placeholder:text-slate-600 focus:border-purple-500 focus:outline-none" %>
            </td>
            <td class="py-3">
              <span class="font-semibold text-white"><%= game.name %></span>
              <span class="ml-2 font-mono text-xs text-slate-500"><%= game.code %></span>
            </td>
            <td class="py-3 text-right text-slate-300"><%= number_with_delimiter game.rooms_count.to_i %></td>
            <td class="py-3 pl-6">
              <%= hidden_field_tag "#{field}[listed]", "0", id: nil %>
              <label class="inline-flex cursor-pointer items-center gap-2">
                <%= check_box_tag "#{field}[listed]", "1", game.listed != false, class: "peer sr-only" %>
                <span class="relative h-6 w-11 rounded-full bg-slate-700 transition-colors peer-checked:bg-green-500 peer-focus-visible:ring-2 peer-focus-visible:ring-purple-400
                             after:absolute after:left-0.5 after:top-0.5 after:size-5 after:rounded-full after:bg-white after:transition-transform peer-checked:after:translate-x-5"></span>
                <span class="sr-only">Show <%= game.name %> on the site</span>
              </label>
            </td>
            <td class="py-3 pr-5 text-right">
              <% if game.slug.present? %>
                <%= link_to "Page ↗", game_path(game), target: "_blank", rel: "noopener",
                      class: "text-xs font-semibold text-purple-300 hover:text-purple-200" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <p class="text-xs text-slate-500">
      Numbered games come first (1, 2, 3…). The rest follow, most rooms first. A hidden game has no page
      and is left out of the catalog, the sitemap and the game-over suggestions.
    </p>
    <button class="rounded-lg bg-purple-600 px-5 py-2 font-semibold text-white hover:bg-purple-500 cursor-pointer">Save</button>
  </div>
<% end %>
