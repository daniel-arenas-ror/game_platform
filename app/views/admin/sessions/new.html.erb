<% content_for :title, "Log in" %>

<div class="mx-auto mt-10 sm:mt-20 max-w-sm rounded-3xl border border-slate-800 bg-slate-900 p-6 sm:p-8 shadow-2xl">
  <h1 class="text-2xl font-extrabold tracking-tight text-white">Admin</h1>
  <p class="mt-1 text-sm text-slate-400">Log in to see the stats.</p>

  <%= form_for resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-5" } do |f| %>
    <div>
      <%= f.label :email, "EMAIL", class: "block text-xs font-black text-slate-500 mb-2 tracking-widest" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "username", required: true,
            class: "w-full bg-slate-950 border-2 border-slate-700 rounded-xl px-4 py-3 text-white font-semibold focus:border-purple-500 focus:outline-none transition-colors" %>
    </div>

    <div>
      <%= f.label :password, "PASSWORD", class: "block text-xs font-black text-slate-500 mb-2 tracking-widest" %>
      <%= f.password_field :password, autocomplete: "current-password", required: true,
            class: "w-full bg-slate-950 border-2 border-slate-700 rounded-xl px-4 py-3 text-white font-semibold focus:border-purple-500 focus:outline-none transition-colors" %>
    </div>

    <%= f.submit "LOG IN", class: "w-full rounded-xl bg-purple-600 hover:bg-purple-500 px-6 py-4 text-sm font-black tracking-widest text-white transition-colors active:scale-[0.98] cursor-pointer" %>
  <% end %>
</div>
