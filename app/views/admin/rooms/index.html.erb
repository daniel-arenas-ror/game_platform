<% content_for :title, "Rooms" %>
<% filters = { status: @status, game: @game&.id, q: @query.presence }.compact %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight text-white">Rooms</h1>
    <p class="mt-1 text-sm text-slate-400">
      <%= number_with_delimiter @total %> <%= @total == 1 ? "room" : "rooms" %><%= " matching" if filters.any? %> · newest first · times in UTC
    </p>
  </div>

  <nav aria-label="Status" class="flex flex-wrap rounded-xl border border-slate-800 bg-slate-900 p-1 text-sm font-semibold">
    <% [ [ nil, "All", @status_counts.values.sum ] ].concat(Admin::RoomsController::STATUSES.map { [ _1, _1.capitalize, @status_counts[_1].to_i ] }).each do |key, label, count| %>
      <%= link_to admin_rooms_path(filters.merge(status: key).compact), aria: { current: (key == @status ? "page" : nil) },
            class: "rounded-lg px-3 py-1.5 transition-colors #{key == @status ? 'bg-purple-600 text-white' : 'text-slate-400 hover:text-white'}" do %>
        <%= label %> <span class="tabular-nums opacity-70"><%= number_with_delimiter count %></span>
      <% end %>
    <% end %>
  </nav>
</div>

<%= form_with url: admin_rooms_path, method: :get, class: "mt-6 flex flex-wrap items-end gap-3" do %>
  <%= hidden_field_tag :status, @status if @status %>
  <div>
    <%= label_tag :q, "Room code", class: "block text-xs font-black uppercase tracking-widest text-slate-500" %>
    <%= text_field_tag :q, @query, maxlength: 4, autocomplete: "off", placeholder: "K7QX",
          class: "mt-1 w-32 rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 font-mono uppercase text-white placeholder:text-slate-600 focus:border-purple-500 focus:outline-none" %>
  </div>
  <div>
    <%= label_tag :game, "Game", class: "block text-xs font-black uppercase tracking-widest text-slate-500" %>
    <%= select_tag :game, options_for_select(@games.map { [ _1.name, _1.id ] }, @game&.id), include_blank: "All games",
          class: "mt-1 rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-white focus:border-purple-500 focus:outline-none" %>
  </div>
  <button class="rounded-lg bg-purple-600 px-4 py-2 font-semibold text-white hover:bg-purple-500 cursor-pointer">Search</button>
  <% if filters.except(:status).any? %>
    <%= link_to "Clear", admin_rooms_path(status: @status), class: "px-2 py-2 text-sm text-slate-400 hover:text-white" %>
  <% end %>
<% end %>

<% if @rooms.empty? %>
  <p class="mt-6 rounded-2xl border border-dashed border-slate-700 px-5 py-10 text-center text-slate-400">No rooms found.</p>
<% else %>
  <div class="mt-6 overflow-x-auto rounded-2xl border border-slate-800 bg-slate-900">
    <table class="w-full min-w-[48rem] text-sm tabular-nums">
      <thead class="text-left text-xs uppercase tracking-widest text-slate-500">
        <tr class="border-b border-slate-800">
          <th class="px-5 py-3 font-black">Code</th>
          <th class="py-3 font-black">Game</th>
          <th class="py-3 font-black">Status</th>
          <th class="py-3 text-right font-black">Players now</th>
          <th class="py-3 text-right font-black">Games played</th>
          <th class="py-3 pl-6 font-black">Language</th>
          <th class="py-3 font-black">Created</th>
          <th class="px-5 py-3 font-black">Last activity</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800">
        <% @rooms.each do |room| %>
          <tr class="hover:bg-slate-800/50">
            <td class="px-5 py-3">
              <%= link_to room.code, admin_room_path(room), class: "font-mono font-bold text-purple-300 hover:text-purple-200 underline-offset-4 hover:underline" %>
            </td>
            <td class="py-3 text-white"><%= @game_names[room.game_id] || "—" %></td>
            <td class="py-3"><%= admin_room_status(room.status) %></td>
            <td class="py-3 text-right text-white"><%= @player_counts[room.id].to_i %></td>
            <td class="py-3 text-right text-slate-300"><%= @games_played[room.id].to_i %></td>
            <td class="py-3 pl-6 uppercase text-slate-400"><%= room.locale %></td>
            <td class="py-3 text-slate-400"><%= admin_time(room.created_at) %></td>
            <td class="px-5 py-3 text-slate-400"><%= admin_time(room.updated_at) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @pages > 1 %>
    <nav aria-label="Pages" class="mt-4 flex items-center justify-between text-sm">
      <% if @page > 1 %>
        <%= link_to "← Newer", admin_rooms_path(filters.merge(page: @page - 1)), class: "rounded-lg border border-slate-700 px-3 py-1.5 font-semibold text-slate-300 hover:text-white" %>
      <% else %><span></span><% end %>
      <span class="text-slate-500">Page <%= @page %> of <%= @pages %></span>
      <% if @page < @pages %>
        <%= link_to "Older →", admin_rooms_path(filters.merge(page: @page + 1)), class: "rounded-lg border border-slate-700 px-3 py-1.5 font-semibold text-slate-300 hover:text-white" %>
      <% else %><span></span><% end %>
    </nav>
  <% end %>
<% end %>
<p class="mt-3 text-xs text-slate-500">
  Players leave the room 30 seconds after closing the page, so "Players now" counts only who is still in it.
  Games played counts every Start, including "play again", since <%= AdminStats.new.tracking_since&.strftime("%b %-d, %Y") || "today" %>.
</p>
