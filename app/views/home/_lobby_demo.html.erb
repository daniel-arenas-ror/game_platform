<%# Hero miniature: the host lobby on a TV and a phone joining it. lobby_demo_controller replays
    the join on a loop; the markup itself is the finished state (full lobby, code typed). %>
<% players = [["Ana", "bg-purple-500"], ["Leo", "bg-pink-500"], ["Mía", "bg-sky-500"], ["Sam", "bg-emerald-500"]] %>
<figure role="img" aria-label="<%= t("home.index.hero_figure") %>" data-controller="lobby-demo"
        class="relative mx-auto w-full max-w-xl lg:max-w-none pb-16 sm:pb-12">
  <div class="rounded-3xl border border-slate-700 bg-slate-800 p-2 sm:p-3 shadow-2xl shadow-black/40" aria-hidden="true">
    <div class="aspect-video rounded-2xl bg-slate-950 p-4 sm:p-7 flex gap-4 sm:gap-7 overflow-hidden">
      <div class="flex-1 min-w-0 flex flex-col">
        <p class="font-display text-white font-extrabold text-base sm:text-2xl truncate"><%= t("mock_game_name") %></p>
        <p class="mt-1 font-mono font-bold text-purple-400 text-xs sm:text-lg"><%= t("home.index.mock_room", code: Room::EXAMPLE_CODE) %></p>
        <div class="mt-auto shrink-0 self-start rounded-lg bg-white p-1 sm:p-2">
          <%= render "home/qr", css: "size-12 sm:size-20" %>
        </div>
      </div>
      <div class="w-[46%] rounded-lg sm:rounded-xl bg-slate-800/80 border border-slate-700 p-2.5 sm:p-4 flex flex-col gap-1.5 sm:gap-2.5">
        <p class="text-[0.6rem] sm:text-xs font-black tracking-widest text-slate-400"><%= t("home.index.mock_players") %></p>
        <% players.each do |name, color| %>
          <div data-lobby-demo-target="player" class="flex items-center gap-2 rounded-md sm:rounded-lg bg-slate-700/70 px-1.5 py-1 sm:px-2.5 sm:py-1.5">
            <span class="size-4 sm:size-6 rounded-full <%= color %> text-[0.5rem] sm:text-xs font-bold text-white flex items-center justify-center"><%= name[0] %></span>
            <span class="text-[0.65rem] sm:text-sm font-bold text-white"><%= name %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%= render layout: "home/phone", locals: { css: "absolute bottom-0 right-3 sm:right-8 w-28 sm:w-40 rotate-3 px-2.5! sm:px-3.5!" } do %>
    <p class="text-[0.55rem] sm:text-[0.7rem] font-black tracking-widest text-slate-400 text-center"><%= t("home.index.mock_room_code") %></p>
    <div class="mt-2 grid grid-cols-4 gap-1">
      <% Room::EXAMPLE_CODE.each_char do |ch| %>
        <span data-lobby-demo-target="slot" data-char="<%= ch %>"
              class="aspect-square rounded-md border border-slate-600 bg-slate-900 font-mono font-black text-[0.7rem] sm:text-sm text-white flex items-center justify-center"><%= ch %></span>
      <% end %>
    </div>
    <p data-lobby-demo-target="joined" class="mt-3 rounded-md bg-pink-600 py-1 sm:py-1.5 text-center text-[0.6rem] sm:text-xs font-black text-white"><%= t("home.index.mock_joined") %></p>
  <% end %>

  <%# Floating bits around the screen: players and a score, bobbing out of step %>
  <div aria-hidden="true" class="pointer-events-none">
    <span class="absolute -top-5 -left-3 sm:-left-6 size-11 sm:size-14 rounded-full bg-pink-600 border-4 border-slate-900 font-display font-extrabold text-white text-lg sm:text-xl flex items-center justify-center animate-float [--float-rotate:-8deg]">L</span>
    <span class="absolute top-1/2 -left-4 sm:-left-8 size-9 sm:size-11 rounded-full bg-sky-500 border-4 border-slate-900 font-display font-extrabold text-white flex items-center justify-center animate-float [animation-delay:-2s] [--float-rotate:6deg]">M</span>
    <span class="absolute -top-4 right-10 sm:right-16 rounded-full bg-yellow-400 px-3 py-1 font-mono font-black text-sm sm:text-base text-slate-950 animate-float [animation-delay:-4s] [--float-rotate:4deg]">+100</span>
    <span class="absolute bottom-2 sm:bottom-0 left-1/4 size-9 sm:size-10 rounded-full bg-green-500 border-4 border-slate-900 text-slate-950 flex items-center justify-center animate-float [animation-delay:-1s]">
      <svg class="size-4 sm:size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </span>
  </div>
</figure>
