<%# The picture for "How it works" step 1–3: the TV lobby, a phone joining, a phone playing.
    Decorative; the step's text says it all. %>
<% case step %>
<% when 1 %>
  <div class="w-full max-w-md rounded-3xl border border-slate-700 bg-slate-800 p-2.5 shadow-2xl shadow-black/40">
    <div class="aspect-video rounded-2xl bg-slate-950 p-5 sm:p-6 flex items-center gap-5">
      <div class="rounded-xl bg-white p-2"><%= render "home/qr", css: "size-20 sm:size-24" %></div>
      <div class="flex-1 space-y-2">
        <p class="font-mono font-black text-2xl sm:text-3xl tracking-[0.3em] text-purple-400"><%= Room::EXAMPLE_CODE %></p>
        <% 3.times do |i| %>
          <span class="block h-5 rounded-md bg-slate-800 animate-pulse" style="width: <%= 90 - i * 18 %>%"></span>
        <% end %>
      </div>
    </div>
  </div>
<% when 2 %>
  <%= render layout: "home/phone", locals: { css: "w-44 sm:w-52 -rotate-3" } do %>
    <p class="text-[0.7rem] font-black tracking-widest text-slate-400 text-center"><%= t("home.index.mock_room_code") %></p>
    <div class="mt-3 grid grid-cols-4 gap-1.5">
      <% Room::EXAMPLE_CODE.each_char do |ch| %>
        <span class="aspect-square rounded-lg border-2 border-purple-400 bg-slate-900 font-mono font-black text-lg text-white flex items-center justify-center"><%= ch %></span>
      <% end %>
    </div>
    <div class="mt-4 h-9 rounded-lg border-2 border-slate-700 bg-slate-900"></div>
    <p class="mt-3 rounded-lg bg-pink-600 py-2 text-center text-sm font-black text-white"><%= t("home.index.mock_joined") %></p>
  <% end %>
<% else %>
  <div class="relative">
    <%= render layout: "home/phone", locals: { css: "w-44 sm:w-52 rotate-3" } do %>
      <div class="grid grid-cols-2 gap-2">
        <% [["bg-purple-600", '<path d="M12 4 21 20H3z"/>'], ["bg-pink-600", '<circle cx="12" cy="12" r="8"/>'],
            ["bg-sky-600", '<rect x="4" y="4" width="16" height="16" rx="2"/>'], ["bg-emerald-600", '<path d="m12 2 10 10-10 10L2 12z"/>']].each do |color, shape| %>
          <span class="aspect-square rounded-xl <%= color %> flex items-center justify-center">
            <svg class="size-8 text-white/90" viewBox="0 0 24 24" fill="currentColor"><%= shape.html_safe %></svg>
          </span>
        <% end %>
      </div>
    <% end %>
    <span class="absolute -top-4 -right-6 rounded-full bg-yellow-400 px-3.5 py-1.5 font-mono font-black text-lg text-slate-950 shadow-lg animate-float">+100</span>
  </div>
<% end %>
