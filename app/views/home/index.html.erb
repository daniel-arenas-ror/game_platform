<% content_for :head do %>
  <script type="application/ld+json">
    <%= raw json_escape({
      "@context" => "https://schema.org",
      "@type" => "WebApplication",
      "name" => SeoHelper::SITE_NAME,
      "url" => root_url,
      "description" => t("seo.default_description"),
      "inLanguage" => I18n.locale.to_s,
      "applicationCategory" => "GameApplication",
      "operatingSystem" => t("game_pages.operating_system"),
      "offers" => { "@type" => "Offer", "price" => "0", "priceCurrency" => "USD" }
    }.to_json) %>
  </script>
<% end %>

<%
  check_icon = '<svg class="size-4 text-green-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>'.html_safe
  hero_words = t(".hero_words")
  # Solid blocks behind the rotating hero word, in turn (dark enough for white text)
  word_colors = %w[bg-purple-600 bg-pink-600 bg-emerald-600 bg-sky-600]
  link_css = "rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400"
%>

<div class="bg-slate-900 overflow-x-clip" data-controller="reveal">

  <%# ── Hero ─────────────────────────────────────────────────────────────── %>
  <section class="px-4 sm:px-6 lg:px-8 pt-10 pb-20 sm:pt-16 lg:pt-20 lg:pb-28">
    <div class="max-w-6xl mx-auto grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] gap-16 items-center">
      <div class="max-w-xl">
        <h1 class="text-display text-5xl sm:text-7xl text-white">
          <%= t(".hero_lead") %>
          <span class="sr-only"><%= t(".hero_words_all") %></span>
          <span aria-hidden="true" class="block mt-2 sm:mt-3">
            <span data-controller="word-cycle"
                  data-word-cycle-words-value="<%= hero_words.to_json %>"
                  data-word-cycle-colors-value="<%= word_colors.to_json %>"
                  class="inline-block overflow-hidden whitespace-nowrap align-bottom rounded-2xl sm:rounded-3xl px-3 sm:px-4 pt-1 pb-2 transition-colors duration-300 <%= word_colors.first %>">
              <span data-word-cycle-target="word" class="inline-block"><%= hero_words.first %></span>
            </span>
          </span>
        </h1>
        <p class="mt-7 text-lg sm:text-xl text-slate-300 text-pretty">
          <%= t(".hero_text") %>
        </p>
        <div class="mt-9 flex flex-col sm:flex-row gap-4">
          <%= link_to t(".start_game"), games_path, class: "btn btn-lg" %>
          <%= link_to t(".join_game"), find_room_path, class: "btn btn-lg btn-secondary" %>
        </div>
        <ul class="mt-8 flex flex-wrap gap-2">
          <% t("perks").values_at(:no_registration, :no_app, :free).each do |perk| %>
            <li class="chip"><%= check_icon %><%= perk %></li>
          <% end %>
        </ul>
      </div>

      <%= render "home/lobby_demo" %>
    </div>
  </section>

  <%# ── Every game, sliding past ─────────────────────────────────────────── %>
  <section class="py-14 sm:py-20 border-t border-slate-800" aria-labelledby="games-strip">
    <div class="px-4 sm:px-6 lg:px-8"><div class="max-w-6xl mx-auto flex flex-wrap items-end justify-between gap-4">
      <h2 id="games-strip" class="text-display text-3xl sm:text-5xl text-white text-balance" data-reveal><%= t(".strip_title", count: @strip_games.size) %></h2>
      <%= link_to games_path, class: "group inline-flex items-center gap-1.5 font-semibold text-purple-300 hover:text-white transition-colors #{link_css}" do %>
        <%= t(".see_all_games") %>
        <svg class="size-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      <% end %>
    </div></div>

    <div class="marquee mt-10 overflow-hidden" data-controller="marquee" data-marquee-speed-value="45">
      <ul class="marquee-track gap-5 sm:gap-6 py-6 px-3" data-marquee-target="track">
        <% @strip_games.each_with_index do |game, i| %>
          <li class="shrink-0">
            <%= link_to (game.slug.present? ? game_path(game) : games_path),
                  class: "group block w-52 sm:w-64 rounded-3xl border-4 border-slate-800 bg-slate-800 overflow-hidden shadow-xl shadow-black/30 transition-transform duration-300 ease-out-expo hover:-translate-y-2 hover:rotate-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-400 #{i.even? ? "-rotate-2" : "rotate-2"}" do %>
              <%= game_art_tag game, alt: "", card: true, sizes: "256px",
                    class: "w-full aspect-[4/3] object-cover object-top" %>
              <span class="flex items-center gap-2 px-4 py-3">
                <span class="size-2.5 shrink-0 rounded-full <%= game_accent(game)[:dot] %>"></span>
                <span class="font-display font-extrabold text-white truncate"><%= game.name %></span>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <%# ── Who it's for: one solid block per setting ────────────────────────── %>
  <section class="px-4 sm:px-6 lg:px-8 py-20 sm:py-28" aria-labelledby="any-room">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl" data-reveal>
        <h2 id="any-room" class="text-display text-4xl sm:text-6xl text-white text-balance"><%= t(".any_room_title") %></h2>
        <p class="mt-5 text-lg text-slate-400 text-pretty"><%= t(".any_room_text") %></p>
      </div>

      <%
        blocks = {
          classroom: { css: "bg-purple-600 text-white", muted: "text-purple-100", icon: :school },
          work:      { css: "bg-pink-700 text-white", muted: "text-pink-100", icon: :briefcase },
          family:    { css: "bg-emerald-400 text-slate-950", muted: "text-emerald-950", icon: :home }
        }
      %>
      <div class="mt-14 grid md:grid-cols-3 gap-5" data-reveal-stagger="120">
        <% blocks.each do |key, style| %>
          <% label, headline, body = t(".use_cases.#{key}").values_at(:label, :headline, :body) %>
          <article data-reveal="scale" class="relative overflow-hidden rounded-[2rem] p-7 sm:p-8 flex flex-col min-h-[26rem] <%= style[:css] %>">
            <%= game_page_icon(style[:icon], css: "absolute -right-6 -top-6 size-40 opacity-15 rotate-12") %>
            <p class="eyebrow <%= style[:muted] %>"><%= label %></p>
            <h3 class="mt-3 text-3xl font-extrabold text-balance leading-tight"><%= headline %></h3>
            <p class="mt-3 text-pretty <%= style[:muted] %>"><%= body %></p>

            <% games = @use_case_games[key] %>
            <% if games.any? %>
              <ul class="mt-auto pt-8 space-y-2.5">
                <% games.each do |game| %>
                  <li>
                    <%= link_to (game.slug.present? ? game_path(game) : games_path),
                          class: "group flex items-center gap-3 rounded-2xl bg-black/15 hover:bg-black/25 p-2 pr-4 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" do %>
                      <%= game_art_tag game, alt: "", card: true, sizes: "48px",
                            class: "size-12 shrink-0 rounded-xl object-cover object-top" %>
                      <span class="flex-1 font-bold leading-snug"><%= game.name %></span>
                      <svg class="size-4 shrink-0 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <%# ── Why play together, beside a live leaderboard ─────────────────────── %>
  <section class="px-4 sm:px-6 lg:px-8 py-20 sm:py-28 bg-slate-950 border-y border-slate-800" aria-labelledby="why-play">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl" data-reveal>
        <h2 id="why-play" class="text-display text-4xl sm:text-6xl text-white text-balance"><%= t(".why_title") %></h2>
        <p class="mt-5 text-lg text-slate-400 text-pretty"><%= t(".why_text") %></p>
      </div>

      <div class="mt-14 grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] gap-12 lg:gap-16 items-start">
        <div class="lg:sticky lg:top-28" data-reveal="scale">
          <%= render "home/leaderboard_demo" %>
        </div>

        <%
          benefit_icons = [
            ["bg-purple-600", '<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/>'],
            ["bg-pink-600", '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>'],
            ["bg-sky-600", GamePagesHelper::ICON_PATHS[:users]],
            ["bg-emerald-600", '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>'],
            ["bg-orange-600", GamePagesHelper::ICON_PATHS[:home]]
          ]
        %>
        <dl class="space-y-3" data-reveal-stagger="90">
          <% t(".benefits").each_with_index do |benefit, i| %>
            <% color, icon = benefit_icons[i % benefit_icons.size] %>
            <%# A <dl> group may only hold <dt>/<dd>, so the icon sits inside the <dt>, pinned left %>
            <div data-reveal class="relative min-h-22 rounded-3xl border border-slate-800 bg-slate-900 p-5 pl-22 sm:p-6 sm:pl-24 transition-colors hover:border-slate-700">
              <dt class="font-display text-xl font-extrabold text-white">
                <span class="absolute left-5 top-5 sm:left-6 sm:top-6 size-12 rounded-2xl <%= color %> text-white flex items-center justify-center" aria-hidden="true">
                  <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= icon.html_safe %></svg>
                </span>
                <%= benefit[:title] %>
              </dt>
              <dd class="mt-1 text-slate-400 text-pretty"><%= benefit[:body] %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    </div>
  </section>

  <%= ad_slot :home, css: "px-4 mt-16 max-w-3xl mx-auto" %>

  <%# ── Simple: in the room or on a call ─────────────────────────────────── %>
  <section class="px-4 sm:px-6 lg:px-8 py-20 sm:py-28" aria-labelledby="simple">
    <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <div data-reveal>
          <h2 id="simple" class="text-display text-4xl sm:text-6xl text-white text-balance"><%= t(".simple_title") %></h2>
          <ul class="mt-7 flex flex-wrap gap-2">
            <% t("perks").values_at(:no_downloads, :no_accounts, :any_browser).each do |perk| %>
              <li class="chip"><%= check_icon %><%= perk %></li>
            <% end %>
          </ul>
        </div>

        <div class="mt-10 grid sm:grid-cols-2 gap-4" data-reveal-stagger="120">
          <div data-reveal class="rounded-3xl border border-slate-700 bg-slate-800 p-6">
            <span class="size-11 rounded-2xl bg-purple-600 text-white flex items-center justify-center" aria-hidden="true">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            </span>
            <h3 class="mt-4 text-xl font-extrabold text-white"><%= t(".same_room_title") %></h3>
            <p class="mt-2 text-slate-400 text-pretty"><%= t(".same_room_text") %></p>
          </div>
          <div data-reveal class="rounded-3xl border border-slate-700 bg-slate-800 p-6">
            <span class="size-11 rounded-2xl bg-emerald-600 text-white flex items-center justify-center" aria-hidden="true">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 13 5.2 3.5a.5.5 0 0 0 .8-.4V7.9a.5.5 0 0 0-.8-.4L16 11"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>
            </span>
            <h3 class="mt-4 text-xl font-extrabold text-white"><%= t(".video_call_title") %></h3>
            <p class="mt-2 text-slate-400 text-pretty">
              <%= t(".video_call_text_html", join_link: link_to("#{request.host}#{find_room_path}", find_room_path, class: "text-purple-300 hover:text-white underline underline-offset-4 decoration-purple-500/50")) %>
            </p>
            <p class="mt-3 text-sm text-slate-400"><%= t(".video_call_note") %></p>
          </div>
        </div>
      </div>

      <div data-reveal="scale"><%= render "home/orbit" %></div>
    </div>
  </section>

  <%# ── How it works: the picture stays put while the steps scroll by (lg) ── %>
  <section class="px-4 sm:px-6 lg:px-8 pb-20 sm:pb-28" aria-labelledby="how-it-works">
    <div class="max-w-6xl mx-auto">
      <h2 id="how-it-works" class="text-display text-4xl sm:text-6xl text-white" data-reveal><%= t(".how_title") %></h2>

      <div class="steps-stage mt-6 lg:grid lg:grid-cols-2 lg:gap-16" data-controller="steps" data-active="1">
        <figure role="img" aria-label="<%= t(".steps_figure") %>" class="hidden lg:block">
          <div class="sticky top-0 h-screen grid place-items-center" aria-hidden="true">
            <% 1.upto(3) do |n| %>
              <div data-step-visual="<%= n %>" class="col-start-1 row-start-1 w-full flex justify-center"><%= render "home/step_visual", step: n %></div>
            <% end %>
          </div>
        </figure>

        <ol>
          <% t(".steps").each_with_index do |step, i| %>
            <li class="py-12 lg:py-0 lg:min-h-[70vh] flex flex-col justify-center border-t border-slate-800 lg:border-0 first:border-0">
              <div data-reveal data-steps-target="step" data-step="<%= i + 1 %>">
                <span class="font-display text-7xl sm:text-8xl font-extrabold text-purple-500 tabular-nums leading-none" aria-hidden="true"><%= format("%02d", i + 1) %></span>
                <h3 class="mt-4 text-3xl sm:text-4xl font-extrabold text-white text-balance"><%= step[:title] %></h3>
                <p class="mt-4 text-lg text-slate-400 text-pretty max-w-md"><%= format(step[:body], count: @games_count) %></p>
              </div>
              <div class="lg:hidden mt-10 flex justify-center" aria-hidden="true"><%= render "home/step_visual", step: i + 1 %></div>
            </li>
          <% end %>
        </ol>
      </div>
    </div>
  </section>

  <%# ── Closing call to action ───────────────────────────────────────────── %>
  <section class="px-4 sm:px-6 lg:px-8 pb-24 sm:pb-32" aria-labelledby="ready">
    <div class="relative overflow-hidden max-w-6xl mx-auto rounded-[2.5rem] bg-purple-600 px-6 py-16 sm:px-14 sm:py-24 text-center" data-reveal="scale">
      <div aria-hidden="true" class="pointer-events-none">
        <span class="absolute -left-10 -top-10 size-40 rounded-full bg-purple-500"></span>
        <span class="absolute -right-8 -bottom-14 size-52 rounded-full bg-purple-700"></span>
        <span class="absolute right-[12%] top-10 size-10 rounded-full bg-pink-500 animate-float"></span>
        <span class="absolute left-[14%] bottom-12 size-7 rounded-full bg-yellow-400 animate-float [animation-delay:-3s]"></span>
      </div>
      <div class="relative">
        <h2 id="ready" class="text-display text-4xl sm:text-7xl text-white text-balance"><%= t(".ready_title") %></h2>
        <p class="mt-5 text-lg sm:text-xl text-purple-100 text-pretty"><%= t(".ready_text") %></p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <%= link_to t(".start_game"), games_path, class: "btn btn-lg btn-light" %>
          <%= link_to t(".join_game"), find_room_path, class: "btn btn-lg btn-secondary" %>
        </div>
      </div>
    </div>
  </section>

</div>
