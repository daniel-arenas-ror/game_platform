<% content_for :head do %>
  <script type="application/ld+json">
    <%= raw json_escape({
      "@context" => "https://schema.org",
      "@type" => "WebApplication",
      "name" => SeoHelper::SITE_NAME,
      "url" => root_url,
      "description" => SeoHelper::DEFAULT_DESCRIPTION,
      "applicationCategory" => "GameApplication",
      "operatingSystem" => "Any (web browser)",
      "offers" => { "@type" => "Offer", "price" => "0", "priceCurrency" => "USD" },
      "hasPart" => @games.map { |g| { "@type" => "VideoGame", "name" => g.name, "description" => g.description } }
    }.to_json) %>
  </script>
<% end %>

<div class="bg-slate-900 min-h-screen py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    
    <header class="text-center mb-16">
      <h1 class="text-5xl sm:text-6xl font-extrabold tracking-tight text-white mb-5">
        <%= SeoHelper::SITE_NAME %>
      </h1>
      <p class="text-purple-300 text-xl font-semibold mb-3">Free party games you play from your phone</p>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto text-pretty">
        Put the host screen on a TV or laptop, friends scan the QR code and join from their phones.
        No app to install, no sign-up — just pick a game and play together.
      </p>
    </header>

    <% unless @room %>
      <div class="max-w-md mx-auto mb-16 bg-slate-800 border border-slate-700 rounded-2xl p-5">
        <%= form_with url: find_room_path, method: :get, class: "flex gap-3" do |f| %>
          <%= f.label :code, "Room code", class: "sr-only" %>
          <%= f.text_field :code,
                placeholder: "ROOM CODE",
                maxlength: 4,
                required: true,
                autocomplete: "off",
                autocapitalize: "characters",
                spellcheck: false,
                class: "min-w-0 flex-1 bg-slate-900 border-2 border-slate-700 rounded-xl px-4 py-3 text-white text-center font-mono font-black text-xl uppercase tracking-[0.4em] placeholder:text-slate-600 placeholder:tracking-widest focus:border-purple-500 focus:outline-none transition-colors" %>
          <%= f.button "Join", name: nil,
                class: "shrink-0 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-black px-6 rounded-xl transition-transform active:scale-95 cursor-pointer" %>
        <% end %>
        <% if flash[:alert] %>
          <p class="text-red-400 text-sm text-center mt-3"><%= flash[:alert] %></p>
        <% else %>
          <p class="text-slate-400 text-sm text-center mt-3">Got a code from the host's screen? Enter it to join.</p>
        <% end %>
      </div>
    <% end %>

    <% if @room %>
      <div class="mb-10 bg-slate-800 border border-purple-500/60 rounded-2xl p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <p class="text-white font-bold text-lg">
            Changing game for room <span class="text-purple-400 font-black tracking-widest"><%= @room.code %></span>
          </p>
          <p class="text-slate-400 text-sm">Pick a new game, or configure <%= @room.game.name %> again. Players stay in the room.</p>
        </div>
        <%= link_to "Cancel", playing_room_path(@room.code),
              class: "text-slate-400 hover:text-white text-sm underline underline-offset-4 transition-colors shrink-0" %>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @games.each do |game| %>
        <% current_game = @room&.game_id == game.id %>
        <div class="bg-slate-800 rounded-2xl overflow-hidden border <%= current_game ? "border-purple-500" : "border-slate-700" %> hover:border-purple-500/70 transition-colors group">
          <div class="relative h-48 bg-slate-700 flex items-center justify-center overflow-hidden">
            <% if File.exist?(Rails.public_path.join("games", game.code, "instructions.png")) %>
              <%= image_tag "/games/#{game.code}/instructions.png", alt: "#{game.name} — how to play", loading: "lazy",
                    class: "w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-500 ease-out" %>
            <% else %>
              <span class="text-slate-500 text-5xl">🎮</span>
            <% end %>
            <% if current_game %>
              <span class="absolute top-3 right-3 bg-purple-600 text-white text-xs font-bold px-3 py-1 rounded-full">Current game</span>
            <% end %>
          </div>
          
          <div class="p-6">
            <h2 class="text-xl font-bold text-white mb-2"><%= game.name %></h2>
            <p class="text-slate-400 mb-6 line-clamp-2"><%= game.description %></p>
            
            <% if @room %>
              <%= button_to change_game_room_path(@room.code), params: { game_id: game.id }, method: :post, class: "w-full bg-purple-500/15 hover:bg-purple-600 border border-purple-500/30 hover:border-purple-600 text-purple-100 hover:text-white font-semibold py-3 px-4 rounded-xl transition-colors text-center cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400" do %>
                <%= current_game ? "Configure" : "Switch to this game" %>
              <% end %>
            <% else %>
              <%= button_to rooms_path(game_id: game.id), method: :post, class: "w-full bg-purple-500/15 hover:bg-purple-600 border border-purple-500/30 hover:border-purple-600 text-purple-100 hover:text-white font-semibold py-3 px-4 rounded-xl transition-colors text-center cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400" do %>
                Play Now
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Empty State / Add Seed Data Prompt -->
      <% if @games.empty? %>
        <div class="col-span-full text-center py-20 border-2 border-dashed border-slate-700 rounded-3xl">
          <p class="text-slate-500">No games found in the database. Run the seed command!</p>
        </div>
      <% end %>
    </div>

    <%# Below the game cards with a wide gap, so it is never next to a Play button %>
    <%= ad_slot :home, css: "mt-16 max-w-3xl mx-auto" %>

    <section class="mt-24 max-w-5xl mx-auto" aria-labelledby="how-it-works">
      <h2 id="how-it-works" class="text-2xl font-bold text-white mb-8">How it works</h2>
      <ol class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-8">
        <li class="border-t border-slate-700 pt-6">
          <h3 class="text-lg font-bold text-white mb-2"><span class="text-purple-400 tabular-nums mr-2">1</span>Create a room</h3>
          <p class="text-slate-400">Choose a game above. The host screen shows a room code and a QR code — put it on the biggest screen you have.</p>
        </li>
        <li class="border-t border-slate-700 pt-6">
          <h3 class="text-lg font-bold text-white mb-2"><span class="text-purple-400 tabular-nums mr-2">2</span>Join from your phone</h3>
          <p class="text-slate-400">Players scan the QR code, type a nickname and they're in. Works in any mobile browser.</p>
        </li>
        <li class="border-t border-slate-700 pt-6">
          <h3 class="text-lg font-bold text-white mb-2"><span class="text-purple-400 tabular-nums mr-2">3</span>Play together</h3>
          <p class="text-slate-400">Trivia, social deduction, memory, tank battles and more — everyone plays live on their own phone.</p>
        </li>
      </ol>
    </section>

    <%= ad_slot :home, css: "mt-16 max-w-3xl mx-auto" %>

  </div>
</div>
