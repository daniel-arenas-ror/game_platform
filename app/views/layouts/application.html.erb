<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <meta name="theme-color" content="#0f172a">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= SeoHelper::SITE_NAME %>">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="canonical" href="<%= canonical_url %>">
    <% if site_header? && @room.nil? %>
      <% I18n.available_locales.each do |locale| %>
        <link rel="alternate" hreflang="<%= locale %>" href="<%= locale_url_for(locale) %>">
      <% end %>
      <link rel="alternate" hreflang="x-default" href="<%= locale_url_for(I18n.default_locale) %>">
    <% end %>

    <meta property="og:type" content="website">
    <meta property="og:locale" content="<%= t("seo.og_locale") %>">
    <meta property="og:site_name" content="<%= SeoHelper::SITE_NAME %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:image" content="<%= og_image_url %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="<%= og_image_url %>">
    <meta name="google-adsense-account" content="<%= AdsHelper::ADSENSE_CLIENT %>">
    <%= adsense_script_tag %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48">
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= js_translations_tag %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-900 min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-purple-600 focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white"><%= t(".skip_to_content") %></a>
    <%= render "shared/site_header" if site_header? %>
    <main id="main">
      <%= yield %>
    </main>
    <%# Game screens fill the whole display, so they skip the footer %>
    <%= render "shared/footer" unless controller_name == "rooms" && action_name == "playing" %>
  </body>
</html>
