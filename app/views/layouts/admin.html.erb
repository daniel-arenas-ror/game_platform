<!DOCTYPE html>
<html lang="en">
  <head>
    <%# Hidden admin: no SEO tags, no share image and no ads, never indexed. %>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Admin" : "Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#0f172a">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-950 min-h-screen text-slate-200">
    <% if admin_user_signed_in? %>
      <header class="border-b border-slate-800 bg-slate-900">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
          <%= link_to admin_root_path, class: "flex items-center gap-2 py-2 text-lg font-extrabold tracking-tight text-white" do %>
            <%= SeoHelper::SITE_NAME %>
            <span class="rounded-md bg-purple-500/15 border border-purple-500/30 px-2 py-0.5 text-[0.65rem] font-black uppercase tracking-widest text-purple-200">Admin</span>
          <% end %>
          <div class="flex items-center gap-3 text-sm">
            <span class="hidden sm:inline text-slate-400"><%= current_admin_user.email %></span>
            <%= button_to "Log out", destroy_admin_user_session_path, method: :delete,
                  class: "rounded-lg border border-slate-700 px-3 py-1.5 font-semibold text-slate-300 hover:border-slate-500 hover:text-white transition-colors cursor-pointer" %>
          </div>
        </div>
      </header>
    <% end %>

    <main id="main" class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
      <% { notice: "border-green-500/30 bg-green-500/10 text-green-200", alert: "border-red-500/30 bg-red-500/10 text-red-200" }.each do |type, style| %>
        <% if flash[type].present? %>
          <p role="<%= type == :alert ? "alert" : "status" %>" class="mx-auto mb-6 max-w-md rounded-xl border px-4 py-3 text-sm font-semibold <%= style %>"><%= flash[type] %></p>
        <% end %>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
