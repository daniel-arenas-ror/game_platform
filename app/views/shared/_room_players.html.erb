<%# Players panel on the lobby and every game screen (rooms/show, rooms/playing). The host gets a
    "Players" button listing everyone, and can remove players who aren't playing so games that wait
    for every answer go on. Players get no button: they only listen, so a removed phone leaves. %>
<div data-controller="room-players"
     data-room-players-room-code-value="<%= room.code %>"
     data-room-players-player-id-value="<%= current_player&.id %>"
     data-room-players-players-url-value="<%= players_room_path(room.code) %>"
     data-room-players-removed-url-value="<%= join_room_path(room.code, removed: "host") %>">
  <% if current_player.nil? %>
    <button type="button" data-action="room-players#open"
            class="fixed bottom-3 left-3 z-[60] flex items-center gap-2 rounded-full border border-slate-700 bg-slate-900/80 px-4 py-2 text-sm font-bold text-slate-300 backdrop-blur hover:text-white hover:border-slate-500 focus-visible:outline-2 focus-visible:outline-purple-400">
      <span aria-hidden="true">👥</span> <%= t(".button") %>
      <span data-room-players-target="count" class="rounded-full bg-slate-700 px-2 text-xs text-white empty:hidden"></span>
    </button>

    <dialog data-room-players-target="dialog" data-action="click->room-players#backdropClose"
            aria-labelledby="room-players-title"
            class="m-auto w-[min(28rem,calc(100%-2rem))] max-h-[80vh] rounded-2xl border border-slate-700 bg-slate-900 p-0 text-white shadow-2xl backdrop:bg-black/70">
      <div class="flex flex-col max-h-[80vh]">
        <div class="flex items-center justify-between border-b border-slate-800 px-5 py-4">
          <h2 id="room-players-title" class="text-lg font-black"><%= t(".title") %></h2>
          <button type="button" data-action="room-players#close" aria-label="<%= t(".close") %>"
                  class="rounded-lg px-2 py-1 text-2xl leading-none text-slate-400 hover:text-white focus-visible:outline-2 focus-visible:outline-purple-400">×</button>
        </div>
        <p class="px-5 pt-4 text-sm text-slate-400"><%= t(".hint") %></p>
        <ul data-room-players-target="list" class="space-y-2 overflow-y-auto px-5 py-4"></ul>
      </div>
    </dialog>
  <% end %>
</div>
