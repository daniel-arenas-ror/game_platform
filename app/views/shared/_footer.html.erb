<% footer_link = "inline-block py-1.5 rounded text-slate-400 hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-purple-400" %>
<footer class="border-t border-slate-800 bg-slate-950 px-4 sm:px-6 lg:px-8 pt-14 pb-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid gap-10 sm:grid-cols-[1fr_auto_auto] sm:gap-16">
      <div class="max-w-xs">
        <%= link_to root_path, aria: { label: SeoHelper::SITE_NAME },
              class: "group inline-block -ml-1 p-1 rounded-xl focus-visible:outline-2 focus-visible:outline-purple-400" do %>
          <%= render "shared/wordmark" %>
        <% end %>
        <p class="mt-3 text-sm text-slate-400"><%= t(".blurb") %></p>
        <ul class="mt-5 flex gap-2" aria-label="<%= t(".follow") %>">
          <% SeoHelper::SOCIAL_LINKS.each do |network, url| %>
            <li>
              <%= link_to url, target: "_blank", rel: "noopener me", aria: { label: t(".social.#{network}") },
                    class: "grid place-items-center size-10 rounded-xl border border-slate-800 bg-slate-900 text-slate-400 hover:text-white hover:border-slate-600 transition-colors focus-visible:outline-2 focus-visible:outline-purple-400" do %>
                <%= game_page_icon(network) %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>

      <nav aria-label="<%= t(".nav") %>" class="contents">
        <div>
          <p class="eyebrow text-slate-400"><%= t(".play") %></p>
          <ul class="mt-3 space-y-1 text-sm font-semibold">
            <li><%= link_to t("shared.site_header.games"), games_path, class: footer_link %></li>
            <li><%= link_to t("shared.site_header.join"), find_room_path, class: footer_link %></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow text-slate-400"><%= t(".info") %></p>
          <ul class="mt-3 space-y-1 text-sm font-semibold">
            <li><%= link_to t(".about"),   about_path,   class: footer_link %></li>
            <li><%= link_to t(".contact"), contact_path, class: footer_link %></li>
            <li><%= link_to t(".privacy"), privacy_path, class: footer_link %></li>
          </ul>
        </div>
      </nav>
    </div>

    <p class="mt-12 border-t border-slate-800 pt-6 text-sm text-slate-400">© <%= Date.current.year %> <%= SeoHelper::SITE_NAME %> · <%= t(".tagline") %></p>
  </div>
</footer>
