<%# Christmas mode: the header's link to the Christmas games page. A little Christmas-tree character
    with a glowing star and twinkling lights (styles in application.css); just the tree on narrow phones. %>
<% active = controller_name == "pages" && action_name == "christmas" %>
<%= link_to christmas_path, aria: { current: (active ? "page" : nil), label: t(".label") },
      class: "flex items-center gap-1.5 px-2 py-1.5 rounded-lg transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400 #{active ? "text-white" : "text-green-300 hover:text-white"}" do %>
  <svg class="xmas-tree size-7 shrink-0 overflow-visible" viewBox="0 0 32 34" aria-hidden="true">
    <rect x="13.5" y="27" width="5" height="5" rx="1" fill="#92400e"/>
    <path d="M16 6L5 18h4.5L3 27h26l-6.5-9H27Z" fill="#16a34a"/>
    <path d="M16 6l5.5 6.5H10.5Z" fill="#22c55e"/>
    <%# The face %>
    <circle cx="13" cy="18.5" r="1.3" fill="#052e16"/>
    <circle cx="19" cy="18.5" r="1.3" fill="#052e16"/>
    <path d="M13.2 21.5q2.8 2.2 5.6 0" fill="none" stroke="#052e16" stroke-width="1.3" stroke-linecap="round"/>
    <circle cx="11.3" cy="20.8" r="1" fill="#f87171" opacity=".8"/>
    <circle cx="20.7" cy="20.8" r="1" fill="#f87171" opacity=".8"/>
    <%# The lights %>
    <% [ [ 9, 25, "#ef4444" ], [ 16, 25.5, "#3b82f6" ], [ 23, 25, "#facc15" ], [ 10.5, 15.5, "#3b82f6" ], [ 21.5, 15.5, "#ef4444" ] ].each_with_index do |(x, y, color), i| %>
      <circle class="xmas-light" cx="<%= x %>" cy="<%= y %>" r="1.4" fill="<%= color %>" style="--i: <%= i %>"/>
    <% end %>
    <%# The star %>
    <path class="xmas-star" d="M16 0l1.5 3.2 3.4.4-2.5 2.3.7 3.4-3.1-1.7-3.1 1.7.7-3.4-2.5-2.3 3.4-.4Z" fill="#facc15"/>
  </svg>
  <span class="max-sm:sr-only"><%= t(".label") %></span>
<% end %>
