<%# Public-site navigation. Room, lobby and game screens skip it so players stay in the game.
    Sticky: clear over the page top, a blurred solid bar with a rule once scrolled (site_header_controller). %>
<header data-controller="site-header"
        class="group/header sticky top-0 z-40 border-b border-transparent transition-colors duration-300 data-scrolled:border-slate-800 data-scrolled:bg-slate-900/95 data-scrolled:backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <%= link_to root_path, aria: { label: SeoHelper::SITE_NAME },
          class: "group -ml-1 p-1 rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400" do %>
      <%= render "shared/wordmark", compact: true %>
    <% end %>

    <nav aria-label="<%= t(".main_nav") %>" class="flex items-center gap-1 sm:gap-2 text-sm font-semibold">
      <% [[t(".home"), root_path, controller_name == "home"],
          [t(".games"), games_path, controller_name == "games"]].each do |label, path, active| %>
        <%= link_to path, aria: { current: (active ? "page" : nil) },
              class: "group relative px-3 py-2 rounded-lg transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-400 #{active ? "text-white" : "text-slate-400 hover:text-white"}" do %>
          <%= label %>
          <%# Underline: drawn under the current page, slides in on hover elsewhere %>
          <span aria-hidden="true" class="absolute inset-x-3 bottom-1 h-0.5 rounded-full bg-purple-400 origin-left transition-transform duration-300 ease-out-expo <%= active ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100" %>"></span>
        <% end %>
      <% end %>
      <%= link_to t(".join"), find_room_path,
            aria: { current: (controller_name == "join" ? "page" : nil) },
            class: "btn btn-sm ml-1 #{"btn-pink" if controller_name == "join"}" %>
      <%# In "Change Game" mode the room's language is fixed, so there is nothing to pick. %>
      <%= render "shared/locale_picker" if @room.nil? %>
    </nav>
  </div>
</header>
